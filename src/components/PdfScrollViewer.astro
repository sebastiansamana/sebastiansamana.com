---
interface Props {
  pdfUrl: string;
  title?: string;
  ariaLabel?: string;
  pageCount: number;
  pageAspectRatios?: number[];
  previewImage?: string;
  previewImageWidth?: number;
  previewImageHeight?: number;
  pageLabel?: string;
  loadingLabel?: string;
  fallbackLabel?: string;
  openPdfLabel?: string;
  pageErrorLabel?: string;
}

const {
  pdfUrl,
  title = 'PDF',
  ariaLabel = 'PDF viewer',
  pageCount,
  pageAspectRatios = [],
  previewImage,
  previewImageWidth,
  previewImageHeight,
  pageLabel = 'Page',
  loadingLabel = 'Preparing high-resolution portfolio',
  fallbackLabel = 'The portfolio viewer could not be loaded.',
  openPdfLabel = 'Open the original PDF',
  pageErrorLabel = 'This page could not be displayed.',
} = Astro.props;

const safePageCount = Number.isFinite(pageCount) && pageCount > 0 ? Math.floor(pageCount) : 1;
const fallbackAspectRatio = 1.414;
const pages = Array.from({ length: safePageCount }, (_, index) => {
  const configuredAspectRatio = pageAspectRatios[index];
  const aspectRatio =
    Number.isFinite(configuredAspectRatio) && configuredAspectRatio > 0
      ? configuredAspectRatio
      : pageAspectRatios[0] || fallbackAspectRatio;

  return {
    aspectRatio,
    number: index + 1,
  };
});

const formatPageNumber = (pageNumber: number) => String(pageNumber).padStart(2, '0');
---

<section
  class="pdf-scroll-viewer"
  data-pdf-scroll-viewer
  data-pdf-url={pdfUrl}
  data-pdf-title={title}
  data-pdf-page-error-label={pageErrorLabel}
  aria-label={ariaLabel}
  aria-busy="true"
>
  <div class="pdf-scroll-viewer__progress" aria-hidden="true"><span></span></div>
  <p class="pdf-scroll-viewer__document-status" data-pdf-document-status role="status">
    {loadingLabel}
  </p>

  <div class="pdf-scroll-viewer__pages">
    {
      pages.map(({ aspectRatio, number }) => (
        <figure
          class="pdf-scroll-viewer__page"
          data-pdf-page
          data-page-number={number}
          style={`--pdf-page-aspect-ratio: ${aspectRatio}`}
          aria-label={`${pageLabel} ${number} / ${safePageCount}`}
        >
          {number === 1 && previewImage ? (
            <img
              class="pdf-scroll-viewer__preview"
              src={previewImage}
              alt=""
              width={previewImageWidth}
              height={previewImageHeight}
              loading="eager"
              decoding="async"
              fetchpriority="high"
              aria-hidden="true"
            />
          ) : null}
          <canvas class="pdf-scroll-viewer__canvas" aria-hidden="true"></canvas>
          <figcaption class="pdf-scroll-viewer__page-status" data-pdf-page-status>
            {formatPageNumber(number)} / {formatPageNumber(safePageCount)}
          </figcaption>
        </figure>
      ))
    }
  </div>

  <p class="pdf-scroll-viewer__fallback" data-pdf-fallback role="alert" hidden>
    {fallbackLabel} <a href={pdfUrl} target="_blank" rel="noopener">{openPdfLabel}</a>
  </p>

  <noscript>
    <p class="pdf-scroll-viewer__fallback pdf-scroll-viewer__fallback--noscript">
      {fallbackLabel} <a href={pdfUrl} target="_blank" rel="noopener">{openPdfLabel}</a>
    </p>
  </noscript>
</section>

<script>
  const viewerSelector = '[data-pdf-scroll-viewer]';
  const pageSelector = '[data-pdf-page]';
  const renderRootMargin = '120% 0px';
  const rangeChunkSize = 262_144;
  const desktopPixelBudget = 6_000_000;
  const mobilePixelBudget = 4_000_000;
  let pdfWorkerTeardown: Promise<void> = Promise.resolve();

  const getPageNumber = (pageElement: HTMLElement) => Number(pageElement.dataset.pageNumber);

  const setupPdfScrollViewer = (viewer: HTMLElement) => {
    if (viewer.dataset.pdfViewerBooted === 'true') return;

    const pdfUrl = viewer.dataset.pdfUrl;
    const title = viewer.dataset.pdfTitle || 'PDF';
    const pageErrorLabel = viewer.dataset.pdfPageErrorLabel || 'This page could not be displayed.';
    const pageElements = Array.from(viewer.querySelectorAll<HTMLElement>(pageSelector));
    const documentStatus = viewer.querySelector<HTMLElement>('[data-pdf-document-status]');
    const fallback = viewer.querySelector<HTMLElement>('[data-pdf-fallback]');

    if (!pdfUrl || pageElements.length === 0) return;

    viewer.dataset.pdfViewerBooted = 'true';
    viewer.classList.add('is-booted');

    let activeRenders = 0;
    let disposed = false;
    let destructionPromise: Promise<void> | null = null;
    let loadingTask: any = null;
    let pdfDocument: any = null;
    let resizeTimer = 0;
    let measuredWidth = Math.round(viewer.getBoundingClientRect().width);
    let measuredPixelRatio = window.devicePixelRatio || 1;
    const maxConcurrentRenders = window.matchMedia('(max-width: 760px)').matches ? 1 : 2;
    const evictionTimers = new Map<number, number>();
    const generations = new Map<number, number>();
    const nearPages = new Set<number>();
    const queuedPages = new Set<number>();
    const renderingPages = new Set<number>();
    const renderTasks = new Map<number, any>();

    const pageElementFor = (pageNumber: number) => pageElements[pageNumber - 1];

    const resetPageStatus = (pageElement: HTMLElement, pageNumber: number) => {
      const status = pageElement.querySelector<HTMLElement>('[data-pdf-page-status]');
      if (!status) return;

      status.removeAttribute('aria-live');
      status.removeAttribute('role');
      status.textContent = `${String(pageNumber).padStart(2, '0')} / ${String(pageElements.length).padStart(2, '0')}`;
    };

    const cancelPageRender = (pageNumber: number) => {
      generations.set(pageNumber, (generations.get(pageNumber) || 0) + 1);
      renderTasks.get(pageNumber)?.cancel?.();
      renderTasks.delete(pageNumber);
    };

    const releasePage = (pageNumber: number) => {
      const pageElement = pageElementFor(pageNumber);
      if (!pageElement) return;

      cancelPageRender(pageNumber);
      queuedPages.delete(pageNumber);
      pageElement.removeAttribute('data-render-key');
      pageElement.classList.remove('is-rendered', 'is-rendering', 'has-render-error');
      resetPageStatus(pageElement, pageNumber);

      const canvas = pageElement.querySelector<HTMLCanvasElement>('canvas');
      if (!canvas) return;

      canvas.width = 0;
      canvas.height = 0;
    };

    const renderPage = async (pageNumber: number) => {
      const pageElement = pageElementFor(pageNumber);
      if (!pdfDocument || !pageElement || disposed || !nearPages.has(pageNumber)) return;

      const generation = (generations.get(pageNumber) || 0) + 1;
      generations.set(pageNumber, generation);
      pageElement.classList.add('is-rendering');
      pageElement.classList.remove('has-render-error');

      let page: any = null;
      let renderTask: any = null;

      try {
        page = await pdfDocument.getPage(pageNumber);
        if (disposed || generations.get(pageNumber) !== generation || !nearPages.has(pageNumber)) return;

        const baseViewport = page.getViewport({ scale: 1 });
        const pageAspectRatio = baseViewport.width / baseViewport.height;
        pageElement.style.setProperty('--pdf-page-aspect-ratio', String(pageAspectRatio));

        const cssWidth = pageElement.clientWidth;
        if (cssWidth <= 0) return;

        const cssHeight = cssWidth / pageAspectRatio;
        const pixelBudget = window.matchMedia('(max-width: 760px)').matches
          ? mobilePixelBudget
          : desktopPixelBudget;
        const nativePixelRatio = Math.min(window.devicePixelRatio || 1, 3);
        const budgetPixelRatio = Math.sqrt(pixelBudget / Math.max(1, cssWidth * cssHeight));
        const outputPixelRatio = Math.max(1, Math.min(nativePixelRatio, budgetPixelRatio));
        const renderKey = `${Math.round(cssWidth)}:${outputPixelRatio.toFixed(2)}:${pageAspectRatio.toFixed(5)}`;

        if (pageElement.dataset.renderKey === renderKey && pageElement.classList.contains('is-rendered')) return;

        const viewport = page.getViewport({
          scale: (cssWidth / baseViewport.width) * outputPixelRatio,
        });
        const nextCanvas = document.createElement('canvas');
        nextCanvas.className = 'pdf-scroll-viewer__canvas';
        nextCanvas.setAttribute('aria-hidden', 'true');
        nextCanvas.width = Math.ceil(viewport.width);
        nextCanvas.height = Math.ceil(viewport.height);

        const context = nextCanvas.getContext('2d', { alpha: false, desynchronized: true });
        if (!context) throw new Error('Canvas rendering is unavailable.');

        renderTask = page.render({
          background: '#ffffff',
          canvas: nextCanvas,
          viewport,
        });
        renderTasks.set(pageNumber, renderTask);
        await renderTask.promise;

        if (
          disposed ||
          generations.get(pageNumber) !== generation ||
          !nearPages.has(pageNumber) ||
          renderTasks.get(pageNumber) !== renderTask
        ) {
          return;
        }

        const currentCanvas = pageElement.querySelector<HTMLCanvasElement>('canvas');
        currentCanvas?.replaceWith(nextCanvas);
        renderTasks.delete(pageNumber);
        pageElement.dataset.renderKey = renderKey;
        pageElement.classList.add('is-rendered');
        pageElement.classList.remove('is-rendering');
      } catch (error: any) {
        if (disposed || error?.name === 'RenderingCancelledException') return;

        const status = pageElement.querySelector<HTMLElement>('[data-pdf-page-status]');
        if (status) {
          status.setAttribute('aria-live', 'polite');
          status.setAttribute('role', 'status');
          status.textContent = pageErrorLabel;
        }
        pageElement.classList.add('has-render-error');
        pageElement.classList.remove('is-rendering');
      } finally {
        if (renderTasks.get(pageNumber) === renderTask) renderTasks.delete(pageNumber);
        if (generations.get(pageNumber) === generation) pageElement.classList.remove('is-rendering');
        page?.cleanup?.();
      }
    };

    const pageDistanceFromViewport = (pageNumber: number) => {
      const pageElement = pageElementFor(pageNumber);
      if (!pageElement) return Number.POSITIVE_INFINITY;

      const rect = pageElement.getBoundingClientRect();
      return Math.abs(rect.top + rect.height / 2 - window.innerHeight / 2);
    };

    const pumpRenderQueue = () => {
      if (!pdfDocument || disposed) return;

      while (activeRenders < maxConcurrentRenders && queuedPages.size > 0) {
        const availablePages = Array.from(queuedPages).filter((pageNumber) => !renderingPages.has(pageNumber));
        if (availablePages.length === 0) return;

        const pageNumber = availablePages.sort(
          (first, second) => pageDistanceFromViewport(first) - pageDistanceFromViewport(second),
        )[0];

        queuedPages.delete(pageNumber);
        if (!nearPages.has(pageNumber)) continue;

        activeRenders += 1;
        renderingPages.add(pageNumber);
        renderPage(pageNumber).finally(() => {
          activeRenders -= 1;
          renderingPages.delete(pageNumber);
          pumpRenderQueue();
        });
      }
    };

    const queuePage = (pageNumber: number) => {
      if (!Number.isFinite(pageNumber) || pageNumber < 1 || pageNumber > pageElements.length) return;

      queuedPages.add(pageNumber);
      pumpRenderQueue();
    };

    const renderObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const pageElement = entry.target;
          if (!(pageElement instanceof HTMLElement)) return;

          const pageNumber = getPageNumber(pageElement);
          if (!Number.isFinite(pageNumber)) return;

          const evictionTimer = evictionTimers.get(pageNumber);
          if (evictionTimer) {
            window.clearTimeout(evictionTimer);
            evictionTimers.delete(pageNumber);
          }

          if (entry.isIntersecting) {
            nearPages.add(pageNumber);
            queuePage(pageNumber);
            return;
          }

          nearPages.delete(pageNumber);
          queuedPages.delete(pageNumber);
          cancelPageRender(pageNumber);
          evictionTimers.set(
            pageNumber,
            window.setTimeout(() => {
              evictionTimers.delete(pageNumber);
              if (!nearPages.has(pageNumber)) releasePage(pageNumber);
            }, 900),
          );
        });
      },
      { rootMargin: renderRootMargin, threshold: 0.01 },
    );

    pageElements.forEach((pageElement) => renderObserver.observe(pageElement));

    const queueVisiblePagesAfterResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resizeTimer = 0;
        const nextWidth = Math.round(viewer.getBoundingClientRect().width);
        const nextPixelRatio = window.devicePixelRatio || 1;
        if (
          Math.abs(nextWidth - measuredWidth) < 8 &&
          Math.abs(nextPixelRatio - measuredPixelRatio) < 0.05
        ) {
          return;
        }

        measuredWidth = nextWidth;
        measuredPixelRatio = nextPixelRatio;
        nearPages.forEach(queuePage);
      }, 160);
    };

    const resizeObserver = new ResizeObserver(queueVisiblePagesAfterResize);
    resizeObserver.observe(viewer);
    window.addEventListener('resize', queueVisiblePagesAfterResize, { passive: true });

    const showFallback = () => {
      viewer.classList.add('is-failed');
      viewer.classList.remove('is-loading');
      viewer.setAttribute('aria-busy', 'false');
      if (documentStatus) documentStatus.textContent = '';
      if (fallback) fallback.hidden = false;
    };

    const destroyLoadingTask = () => {
      if (destructionPromise) return destructionPromise;
      if (!loadingTask?.destroy) return Promise.resolve();

      const taskToDestroy = loadingTask;
      destructionPromise = pdfWorkerTeardown
        .catch(() => {})
        .then(() => taskToDestroy.destroy())
        .catch(() => {});
      pdfWorkerTeardown = destructionPromise;
      return destructionPromise;
    };

    const loadDocument = async () => {
      viewer.classList.add('is-loading');

      try {
        await pdfWorkerTeardown.catch(() => {});
        if (disposed) return;

        const pdfjs = await import('pdfjs-dist/webpack.mjs');
        if (disposed) return;

        loadingTask = pdfjs.getDocument({
          rangeChunkSize,
          url: pdfUrl,
          wasmUrl: '/pdfjs/wasm/',
        });
        pdfDocument = await loadingTask.promise;

        if (disposed) {
          await destroyLoadingTask();
          return;
        }

        if (pdfDocument.numPages !== pageElements.length) {
          throw new Error(
            `${title}: configured for ${pageElements.length} pages, but the PDF contains ${pdfDocument.numPages}.`,
          );
        }

        viewer.classList.add('is-ready');
        viewer.classList.remove('is-loading');
        viewer.setAttribute('aria-busy', 'false');
        if (documentStatus) documentStatus.textContent = '';
        nearPages.forEach(queuePage);
        pumpRenderQueue();
      } catch {
        await destroyLoadingTask();
        if (!disposed) showFallback();
      }
    };

    const dispose = () => {
      if (disposed) return;
      disposed = true;

      renderObserver.disconnect();
      resizeObserver.disconnect();
      window.removeEventListener('resize', queueVisiblePagesAfterResize);
      window.clearTimeout(resizeTimer);
      evictionTimers.forEach((timer) => window.clearTimeout(timer));
      evictionTimers.clear();
      renderTasks.forEach((task) => task?.cancel?.());
      renderTasks.clear();
      queuedPages.clear();
      renderingPages.clear();
      nearPages.clear();

      destroyLoadingTask();

      document.removeEventListener('astro:before-swap', dispose);
    };

    document.addEventListener('astro:before-swap', dispose, { once: true });
    loadDocument();
  };

  const setupPdfScrollViewers = () => {
    document.querySelectorAll<HTMLElement>(viewerSelector).forEach(setupPdfScrollViewer);
  };

  setupPdfScrollViewers();

  if (!window.__varelismPdfScrollViewerReady) {
    window.__varelismPdfScrollViewerReady = true;
    document.addEventListener('astro:page-load', setupPdfScrollViewers);
  }
</script>

<style>
  .pdf-scroll-viewer {
    color: #000000;
    position: relative;
    width: 100%;
  }

  .pdf-scroll-viewer__progress {
    height: 1px;
    inset: 0 0 auto;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
    z-index: 2;
  }

  .pdf-scroll-viewer__progress span {
    background: #691b17;
    display: block;
    height: 100%;
    opacity: 0;
    transform: translateX(-100%);
    width: 34%;
  }

  .pdf-scroll-viewer.is-loading .pdf-scroll-viewer__progress span {
    animation: pdf-progress 1.15s ease-in-out infinite;
    opacity: 0.72;
  }

  .pdf-scroll-viewer__pages {
    display: grid;
    gap: clamp(0.45rem, 1vw, 0.9rem);
    width: 100%;
  }

  .pdf-scroll-viewer:not(.is-booted) .pdf-scroll-viewer__page:not(:first-child),
  .pdf-scroll-viewer.is-failed .pdf-scroll-viewer__page:not(:first-child) {
    display: none;
  }

  .pdf-scroll-viewer__page {
    aspect-ratio: var(--pdf-page-aspect-ratio, 1.414);
    background: #ffffff;
    border: 1px solid #f2f2f2;
    contain: layout paint style;
    display: grid;
    justify-self: center;
    margin: 0;
    overflow: hidden;
    position: relative;
    scroll-margin-top: clamp(6.5rem, 12vh, 8.5rem);
    width: 100%;
  }

  :global(.pdf-scroll-viewer__canvas),
  .pdf-scroll-viewer__preview {
    display: block;
    grid-area: 1 / 1;
    height: 100%;
    object-fit: contain;
    width: 100%;
  }

  :global(.pdf-scroll-viewer__canvas) {
    opacity: 0;
  }

  .pdf-scroll-viewer__preview {
    opacity: 1;
    transition: opacity 160ms ease;
  }

  .pdf-scroll-viewer__page.is-rendered :global(.pdf-scroll-viewer__canvas) {
    opacity: 1;
  }

  .pdf-scroll-viewer__page.is-rendered .pdf-scroll-viewer__preview {
    opacity: 0;
  }

  .pdf-scroll-viewer__page-status {
    color: rgba(0, 0, 0, 0.34);
    font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    font-size: 0.68rem;
    font-weight: 200;
    grid-area: 1 / 1;
    letter-spacing: 0;
    line-height: 1;
    margin: auto;
    opacity: 1;
    pointer-events: none;
    transition: opacity 140ms ease;
    z-index: 1;
  }

  .pdf-scroll-viewer__page:first-child .pdf-scroll-viewer__page-status,
  .pdf-scroll-viewer__page.is-rendered .pdf-scroll-viewer__page-status {
    opacity: 0;
  }

  .pdf-scroll-viewer__page.has-render-error .pdf-scroll-viewer__page-status {
    opacity: 1;
  }

  .pdf-scroll-viewer__document-status {
    border: 0;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .pdf-scroll-viewer__fallback {
    color: #919191;
    font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    font-size: 0.82rem;
    font-weight: 200;
    letter-spacing: 0;
    line-height: 1.35;
    margin: clamp(1rem, 3vw, 2rem) 0 0;
  }

  .pdf-scroll-viewer__fallback[hidden] {
    display: none;
  }

  .pdf-scroll-viewer__fallback a {
    color: #691b17;
    margin-left: 0.2em;
    transition: color 180ms ease;
  }

  .pdf-scroll-viewer__fallback a:focus-visible,
  .pdf-scroll-viewer__fallback a:hover {
    color: #000000;
  }

  .pdf-scroll-viewer__fallback a:focus-visible {
    outline: 1px solid #691b17;
    outline-offset: 0.35rem;
  }

  @keyframes pdf-progress {
    from {
      transform: translateX(-110%);
    }

    to {
      transform: translateX(395%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pdf-scroll-viewer__progress span {
      animation: none !important;
      transform: translateX(0);
    }

    .pdf-scroll-viewer__page-status,
    .pdf-scroll-viewer__preview {
      transition: none;
    }
  }

</style>
