---
interface Props {
  label: string;
  returnHref: string;
  returnLabel: string;
  enableSpanishFallback?: boolean;
}

const {
  label,
  returnHref,
  returnLabel,
  enableSpanishFallback = false,
} = Astro.props;
---

<section class="not-found-page" aria-label={label} data-not-found-page data-varelism-route-reveal>
  <div class="not-found-page__content">
    <h1 class="not-found-page__code">404</h1>
    <a class="not-found-page__link" href={returnHref} data-not-found-link>{returnLabel}</a>
  </div>
</section>

{
  enableSpanishFallback && (
    <script is:inline>
      (() => {
        const normalizedPath = window.location.pathname.replace(/\/index\.html$/, '').replace(/\/+$/, '');
        const isSpanishFallback = normalizedPath === '/esp' || normalizedPath.startsWith('/esp/');

        if (!isSpanishFallback) return;

        document.documentElement.lang = 'es';

        const page = document.querySelector('[data-not-found-page]');
        const link = document.querySelector('[data-not-found-link]');

        page?.setAttribute('aria-label', '404');

        if (link?.tagName === 'A') {
          link.setAttribute('href', '/esp');
          link.textContent = 'Volver al inicio';
        }
      })();
    </script>
  )
}

<style>
  :global(.site-shell > main) {
    max-width: none;
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    padding: 0;
    position: relative;
    width: 100%;
  }

  .not-found-page {
    color: #000000;
    display: block;
    left: 50%;
    line-height: 1;
    max-width: calc(100vw - 2rem);
    position: absolute;
    text-align: center;
    top: 50vh;
    top: 50svh;
    top: 50dvh;
    transform: translate(-50%, -50%);
    width: max-content;
  }

  .not-found-page__content {
    display: grid;
    gap: clamp(0.72rem, 1.45vw, 1.05rem);
    justify-items: center;
  }

  .not-found-page__code {
    color: inherit;
    font-family: var(--font-sans);
    font-size: clamp(1.35rem, 2.1vw, 2.15rem);
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1;
    margin: 0;
  }

  .not-found-page__link {
    font-family: var(--font-sans);
    font-size: clamp(0.82rem, 1vw, 0.98rem);
    font-weight: 200;
    letter-spacing: 0;
    line-height: 1;
  }

  .not-found-page__link {
    color: #691b17;
    display: block;
    transition: color 160ms ease;
  }

  .not-found-page__link:focus-visible {
    color: #000000;
    outline: 1px solid #691b17;
    outline-offset: 0.35rem;
  }

  .not-found-page__link:hover {
    color: #000000;
  }

  @media (hover: none) and (pointer: coarse) {
    .not-found-page__link:active {
      color: #000000;
    }
  }

  @media (max-width: 720px) {
    .not-found-page__code {
      font-size: clamp(0.95rem, 3.8vw, 1.25rem);
    }
  }

  @media (max-width: 560px) {
    .not-found-page {
      max-width: calc(100vw - 1.7rem);
    }
  }
</style>
