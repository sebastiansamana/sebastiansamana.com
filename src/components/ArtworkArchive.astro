---
import type { Artwork } from '../lib/artworks';
import { getArtworkDateLabel, getArtworkMetadata } from '../lib/artworks';

interface Props {
  artworks: Artwork[];
  detailBasePath?: string;
  labels?: {
    empty: string;
    grid: string;
    list: string;
    title: string;
  };
}

const {
  artworks,
  detailBasePath = '/artist/everything/',
  labels = {
    empty: 'No public artworks yet.',
    grid: 'Grid',
    list: 'Index',
    title: 'Sebastian Varela: List of works',
  },
} = Astro.props;
const normalizedDetailBasePath = detailBasePath.endsWith('/') ? detailBasePath : `${detailBasePath}/`;
const getArtworkHref = (artwork: Artwork) => `${normalizedDetailBasePath}${artwork.id}/`;
---

<section class="artwork-archive" data-artwork-archive data-archive-view="grid" aria-label={labels.title}>
  <header class="artwork-archive__header">
    {
      artworks.length > 0 && (
        <div class="artwork-archive__modes" aria-label="Archive view">
          <button type="button" data-archive-view-button="grid" aria-pressed="true">{labels.grid}</button>
          <button type="button" data-archive-view-button="list" aria-pressed="false">{labels.list}</button>
        </div>
      )
    }
  </header>

  {
    artworks.length > 0 ? (
      <>
        <div class="artwork-masonry" data-artwork-masonry>
          <div class="artwork-column-sizer" aria-hidden="true"></div>
          <div class="artwork-gutter-sizer" aria-hidden="true"></div>
          {
            artworks.map((artwork) => (
              <article class="artwork-card">
                <a href={getArtworkHref(artwork)}>
                  {
                    artwork.data.image && artwork.data.imageWidth && artwork.data.imageHeight && (
                      <span class="artwork-card__image-stack">
                        <img
                          class="artwork-card__image artwork-card__image--base"
                          src={artwork.data.image}
                          alt={artwork.data.imageAlt ?? artwork.data.title}
                          width={artwork.data.imageWidth}
                          height={artwork.data.imageHeight}
                          loading="lazy"
                          decoding="async"
                        />
                        {
                          artwork.data.hoverImage && (
                            <img
                              class="artwork-card__image artwork-card__image--hover"
                              src={artwork.data.hoverImage}
                              alt=""
                              width={artwork.data.imageWidth}
                              height={artwork.data.imageHeight}
                              loading="lazy"
                              decoding="async"
                              aria-hidden="true"
                            />
                          )
                        }
                      </span>
                    )
                  }
                  <span class="artwork-card__title">{artwork.data.title}</span>
                  {
                    getArtworkDateLabel(artwork) && (
                      <span class="artwork-card__meta">{getArtworkDateLabel(artwork)}</span>
                    )
                  }
                </a>
              </article>
            ))
          }
        </div>

        <ol class="artwork-index" data-artwork-index>
          {
            artworks.map((artwork) => (
              <li>
                <a href={getArtworkHref(artwork)}>
                  <span class="artwork-index__title">{artwork.data.title}</span>
                  {
                    getArtworkMetadata(artwork).length > 0 && (
                      <span class="artwork-index__meta">
                        {getArtworkMetadata(artwork).map((item) => item.value).join(' / ')}
                      </span>
                    )
                  }
                </a>
              </li>
            ))
          }
        </ol>
      </>
    ) : (
      <p class="artwork-empty">{labels.empty}</p>
    )
  }
</section>

<script>
  import imagesLoaded from 'imagesloaded';
  import Masonry from 'masonry-layout';

  (() => {
    const routeEnterEvent = 'varelism:route-enter';
    const routeEnteringClass = 'varelism-route-entering';

    const waitForAnimationFrame = () =>
      new Promise((resolve) => {
        window.requestAnimationFrame(resolve);
      });

    const waitForFonts = () => {
      if (!document.fonts?.ready) return Promise.resolve();

      return document.fonts.ready.catch(() => {});
    };

    const waitForImage = (image) => {
      if (!(image instanceof HTMLImageElement) || !image.src) return Promise.resolve();

      if (image.complete && image.naturalWidth > 0) {
        return image.decode ? image.decode().catch(() => {}) : Promise.resolve();
      }

      return new Promise((resolve) => {
        const done = () => {
          image.removeEventListener('load', done);
          image.removeEventListener('error', done);
          if (image.decode && image.naturalWidth > 0) {
            image.decode().catch(() => {}).then(resolve);
            return;
          }
          resolve();
        };

        image.addEventListener('load', done, { once: true });
        image.addEventListener('error', done, { once: true });
      });
    };

    const waitForInitialArtworkImages = (grid) => {
      if (!(grid instanceof HTMLElement)) return Promise.resolve();

      const viewportHeight = window.innerHeight || document.documentElement.clientHeight || 0;
      const viewportLead = viewportHeight * 0.15;
      const images = Array.from(grid.querySelectorAll('.artwork-card__image--base')).filter((image) => {
        if (!(image instanceof HTMLImageElement)) return false;

        const rect = image.getBoundingClientRect();

        return rect.top < viewportHeight + viewportLead && rect.bottom > -viewportLead;
      });

      return Promise.all(images.map(waitForImage));
    };

    const setupArchive = () => {
      document.querySelectorAll('[data-artwork-archive]').forEach((archive) => {
        if (!(archive instanceof HTMLElement) || archive.dataset.artworkArchiveBooted === 'true') {
          return;
        }

        archive.dataset.artworkArchiveBooted = 'true';
        archive.setAttribute('aria-busy', 'true');

        const grid = archive.querySelector('[data-artwork-masonry]');
        const viewButtons = Array.from(archive.querySelectorAll('[data-archive-view-button]'));

        let masonry = null;
        let isRevealed = false;

        const revealArchive = () => {
          if (isRevealed) return;

          isRevealed = true;
          archive.dataset.artworkArchiveReady = 'true';
          archive.removeAttribute('aria-busy');

          window.requestAnimationFrame(() => {
            archive.classList.add('is-ready');
          });
        };

        const revealWhenRouteAllows = () => {
          if (!document.documentElement.classList.contains(routeEnteringClass)) {
            revealArchive();
            return;
          }

          window.addEventListener(routeEnterEvent, revealArchive, { once: true });
        };

        const revealAfterStableLayout = async () => {
          await waitForFonts();
          masonry?.layout();
          await waitForAnimationFrame();
          masonry?.layout();
          await waitForInitialArtworkImages(grid);
          masonry?.layout();
          await waitForAnimationFrame();
          revealWhenRouteAllows();
        };

        if (grid instanceof HTMLElement) {
          masonry = new Masonry(grid, {
            columnWidth: '.artwork-column-sizer',
            fitWidth: true,
            gutter: '.artwork-gutter-sizer',
            itemSelector: '.artwork-card',
            percentPosition: false,
          });

          imagesLoaded(grid)
            .on('progress', () => masonry?.layout())
            .on('always', () => masonry?.layout());
        }

        const setView = (view) => {
          archive.dataset.archiveView = view;
          viewButtons.forEach((button) => {
            if (!(button instanceof HTMLButtonElement)) return;
            button.setAttribute('aria-pressed', String(button.dataset.archiveViewButton === view));
          });

          if (view === 'grid') {
            window.requestAnimationFrame(() => masonry?.layout());
          }
        };

        viewButtons.forEach((button) => {
          button.addEventListener('click', () => {
            setView(button instanceof HTMLElement && button.dataset.archiveViewButton === 'list' ? 'list' : 'grid');
          });
        });

        window.requestAnimationFrame(() => masonry?.layout());
        revealAfterStableLayout();
      });
    };

    setupArchive();

    if (window.__varelismArtworkArchiveReady) return;

    window.__varelismArtworkArchiveReady = true;
    document.addEventListener('astro:page-load', setupArchive);
  })();
</script>

<style>
  :global(.site-shell > main) {
    max-width: none;
    padding: clamp(7rem, 13vh, 8.5rem) clamp(1rem, 4vw, 3rem) 0;
    width: 100%;
  }

  .artwork-archive {
    --artwork-gap: clamp(0.8rem, 1.8vw, 1.35rem);
    --artwork-column-width: clamp(11rem, 23vw, 18rem);
    --artwork-footer-text-color: #919191;
    --artwork-meta-hover-color: #b75f58;
    --artwork-title-font-size: clamp(0.82rem, 1vw, 0.98rem);
    --artwork-content-width: calc(
      var(--artwork-column-width) + var(--artwork-column-width) + var(--artwork-column-width) +
        var(--artwork-column-width) + var(--artwork-gap) + var(--artwork-gap) + var(--artwork-gap)
    );
    --artwork-aligned-width: min(100%, var(--artwork-content-width));

    color: #000000;
    margin: 0 auto;
    max-width: 82rem;
    min-height: calc(100vh - clamp(7rem, 13vh, 8.5rem));
    opacity: 0;
    padding-bottom: clamp(2rem, 6vh, 4rem);
    pointer-events: none;
    transition: opacity 450ms ease;
    will-change: opacity;
    width: 100%;
  }

  .artwork-archive.is-ready {
    opacity: 1;
    pointer-events: auto;
  }

  .artwork-archive__header {
    align-items: baseline;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin: 0 auto clamp(2rem, 5vw, 4rem);
    width: var(--artwork-aligned-width);
  }

  .artwork-archive__modes {
    display: flex;
    gap: 0.8rem;
  }

  .artwork-archive__modes button {
    background: transparent;
    border: 0;
    color: #691b17;
    cursor: pointer;
    font: inherit;
    font-size: var(--artwork-title-font-size);
    font-weight: 200;
    line-height: 1;
    padding: 0;
    transition: color 180ms ease;
  }

  .artwork-archive__modes button:focus-visible,
  .artwork-archive__modes button:hover {
    color: #000000;
  }

  .artwork-archive__modes button:focus-visible {
    outline: 1px solid #691b17;
    outline-offset: 0.35rem;
  }

  .artwork-masonry {
    margin: 0 auto;
  }

  .artwork-column-sizer,
  .artwork-card {
    width: var(--artwork-column-width);
  }

  .artwork-gutter-sizer {
    width: var(--artwork-gap);
  }

  .artwork-card {
    margin-bottom: var(--artwork-gap);
  }

  .artwork-card a {
    display: block;
  }

  .artwork-card__image-stack {
    display: grid;
  }

  .artwork-card img {
    display: block;
    grid-area: 1 / 1;
    height: auto;
    pointer-events: none;
    width: 100%;
  }

  .artwork-card__image--hover {
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .artwork-card__title,
  .artwork-card__meta {
    display: block;
    font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    letter-spacing: 0;
    line-height: 1.2;
    transition: color 180ms ease;
  }

  .artwork-card__title {
    font-size: 0.88rem;
    font-weight: 300;
    margin-top: 0.65rem;
  }

  .artwork-card__meta {
    color: var(--artwork-footer-text-color);
    font-size: 0.72rem;
    font-weight: 200;
    margin-top: 0.25rem;
  }

  .artwork-card a:focus-visible .artwork-card__image--hover,
  .artwork-card a:hover .artwork-card__image--hover {
    opacity: 1;
  }

  .artwork-card a:focus-visible .artwork-card__title,
  .artwork-card a:hover .artwork-card__title {
    color: #691b17;
  }

  .artwork-card a:focus-visible .artwork-card__meta,
  .artwork-card a:hover .artwork-card__meta {
    color: var(--artwork-meta-hover-color);
  }

  .artwork-card a:focus-visible {
    outline: 1px solid #691b17;
    outline-offset: 0.35rem;
  }

  .artwork-index {
    display: none;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    width: var(--artwork-aligned-width);
  }

  .artwork-index li {
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }

  .artwork-index li:last-child {
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }

  .artwork-index a {
    align-items: baseline;
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    padding: 0.85rem 0;
  }

  .artwork-index__title {
    font-size: 0.98rem;
    font-weight: 300;
  }

  .artwork-index__title,
  .artwork-index__meta {
    transition: color 180ms ease;
  }

  .artwork-index__meta,
  .artwork-empty {
    color: var(--artwork-footer-text-color);
    font-size: 0.82rem;
    font-weight: 200;
  }

  .artwork-index a:focus-visible .artwork-index__title,
  .artwork-index a:hover .artwork-index__title {
    color: #691b17;
  }

  .artwork-index a:focus-visible .artwork-index__meta,
  .artwork-index a:hover .artwork-index__meta {
    color: var(--artwork-meta-hover-color);
  }

  .artwork-index a:focus-visible {
    outline: 1px solid #691b17;
    outline-offset: 0.35rem;
  }

  .artwork-empty {
    margin: 0 auto;
    width: var(--artwork-aligned-width);
  }

  [data-archive-view='grid'] [data-archive-view-button='grid'],
  [data-archive-view='list'] [data-archive-view-button='list'] {
    display: none;
  }

  [data-archive-view='list'] .artwork-masonry {
    display: none;
  }

  [data-archive-view='list'] .artwork-index {
    display: block;
  }

  @media (max-width: 1312px) {
    .artwork-archive {
      --artwork-content-width: calc(
        var(--artwork-column-width) + var(--artwork-column-width) + var(--artwork-column-width) +
          var(--artwork-gap) + var(--artwork-gap)
      );
    }
  }

  @media (max-width: 720px) {
    :global(.site-shell > main) {
      padding-top: 6.5rem;
    }

    .artwork-archive {
      --artwork-column-width: calc(
        (
            100vw - clamp(1rem, 4vw, 3rem) - clamp(1rem, 4vw, 3rem) -
              var(--artwork-gap) - var(--artwork-gap)
          ) / 3
      );
      --artwork-content-width: calc(
        var(--artwork-column-width) + var(--artwork-column-width) + var(--artwork-column-width) +
          var(--artwork-gap) + var(--artwork-gap)
      );
    }

    .artwork-index a {
      align-items: flex-start;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
  }

  @media (max-width: 560px) {
    .artwork-archive {
      --artwork-column-width: calc(
        (100vw - clamp(1rem, 4vw, 3rem) - clamp(1rem, 4vw, 3rem) - var(--artwork-gap)) / 2
      );
      --artwork-content-width: calc(
        var(--artwork-column-width) + var(--artwork-column-width) + var(--artwork-gap)
      );
      --artwork-title-font-size: 0.72rem;
    }

    .artwork-archive__header {
      gap: 0.65rem;
    }

    .artwork-card__title,
    .artwork-card__meta,
    .artwork-index__title,
    .artwork-index__meta {
      font-size: var(--artwork-title-font-size);
    }
  }
</style>
