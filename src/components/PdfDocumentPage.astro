---
interface Props {
  title: string;
  pdfUrl: string;
  lang?: 'en' | 'es';
  fallbackLabel?: string;
  openLabel?: string;
  indexable?: boolean;
}

const {
  title,
  pdfUrl,
  lang = 'en',
  fallbackLabel = 'This browser could not display the PDF.',
  openLabel = 'Open studio-2-2.pdf',
  indexable = true,
} = Astro.props;
const documentTitle = `${title} PDF | Samana`;
const viewerUrl = `${pdfUrl}#page=1&view=Fit&zoom=page-fit&toolbar=1&navpanes=0`;
const normalizedPath = Astro.url.pathname.replace(/\/index\.html$/, '').replace(/\/+$/, '') || '/';
const canonicalPath = normalizedPath === '/' ? '/' : `${normalizedPath}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang={lang} data-native-pdf-url={pdfUrl}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`${title} architecture portfolio.`} />
    {indexable && <link rel="canonical" href={canonicalUrl} />}
    {indexable && <meta property="og:url" content={canonicalUrl} />}
    {!indexable && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=5" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=5" />
    <link rel="shortcut icon" href="/favicon.ico?v=5" />
    <title>{documentTitle}</title>
    <script>
      import { shouldOpenPdfNatively } from '../scripts/pdf-device.js';

      const nativePdfUrl = document.documentElement.dataset.nativePdfUrl;
      if (nativePdfUrl && shouldOpenPdfNatively()) {
        window.location.replace(nativePdfUrl);
      }
    </script>
  </head>
  <body>
    <iframe src={viewerUrl} title={`${title} PDF`} allowfullscreen>
      <p>{fallbackLabel} <a href={pdfUrl}>{openLabel}</a></p>
    </iframe>
  </body>
</html>

<style is:global>
  html,
  body {
    background: #ffffff;
    height: 100%;
    margin: 0;
    overflow: hidden;
    width: 100%;
  }

  iframe {
    background: #ffffff;
    border: 0;
    display: block;
    height: 100%;
    width: 100%;
  }
</style>
