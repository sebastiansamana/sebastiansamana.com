---
interface Props {
  title: string;
  pdfUrl: string;
  lang?: 'en' | 'es';
  indexable?: boolean;
}

const {
  title,
  pdfUrl,
  lang = 'en',
  indexable = true,
} = Astro.props;
const spanish = lang === 'es';
const documentTitle = `${title} PDF | Samana`;
const viewerUrl = `${pdfUrl}#page=1&view=Fit&zoom=page-fit&toolbar=0&navpanes=0`;
const normalizedPath = Astro.url.pathname.replace(/\/index\.html$/, '').replace(/\/+$/, '') || '/';
const canonicalPath = normalizedPath === '/' ? '/' : `${normalizedPath}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`${title} architecture portfolio.`} />
    {indexable && <link rel="canonical" href={canonicalUrl} />}
    {indexable && <meta property="og:url" content={canonicalUrl} />}
    {!indexable && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{documentTitle}</title>
  </head>
  <body>
    <iframe src={viewerUrl} title={`${title} PDF`} allowfullscreen>
      <p>{spanish ? 'Este navegador no pudo mostrar el PDF.' : 'This browser could not display the PDF.'}</p>
    </iframe>
  </body>
</html>

<style is:global>
  html,
  body {
    background: #ffffff;
    margin: 0;
    height: 100%;
    overflow: hidden;
    width: 100%;
  }

  iframe {
    background: #ffffff;
    border: 0;
    display: block;
    height: 100%;
    width: 100%;
  }
</style>
