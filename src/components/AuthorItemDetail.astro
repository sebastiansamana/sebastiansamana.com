---
import { render } from 'astro:content';
import type { AuthorItem } from '../lib/authorItems';
import { getAuthorItemDetailMetadata, getAuthorItemTitle } from '../lib/authorItems';

interface Props {
  backHref: string;
  backLabel: string;
  item: AuthorItem;
  locale?: 'en' | 'es';
}

const { backHref, backLabel, item, locale = 'en' } = Astro.props;
const metadata = getAuthorItemDetailMetadata(item, locale);
const title = getAuthorItemTitle(item, locale);
const { Content } = await render(item);
const spanishParagraphs = (item.data.spanishBody ?? '')
  .split(/\n{2,}/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
const enquiryEmail = 'bastivarela@icloud.com';
const enquiryDetails = metadata.map((item) => item.value).join(' / ');
const enquiryBody = [
  locale === 'es' ? 'Hola Sebastian,' : 'Hello Sebastian,',
  '',
  locale === 'es'
    ? 'Me gustaría consultar más sobre este texto:'
    : 'I would like to enquire further about this text:',
  '',
  title,
  ...(enquiryDetails ? [enquiryDetails] : []),
  '',
  locale === 'es' ? 'Mi consulta:' : 'My query:',
].join('\n');
const enquiryHref = `mailto:${enquiryEmail}?subject=${encodeURIComponent(
  locale === 'es' ? `Consulta sobre ${title}` : `Enquiry about ${title}`,
)}&body=${encodeURIComponent(enquiryBody)}`;
const enquiryLabel = locale === 'es' ? 'Consultar más' : 'Enquire further';
---

<article class="author-item-detail" data-varelism-route-reveal>
  <a class="author-item-back" href={backHref}>{backLabel}</a>

  <header class="author-item-header">
    <h1>{title}</h1>
    {
      metadata.length > 0 && (
        <dl>
          {
            metadata.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
        </dl>
      )
    }
  </header>

  <section class="author-item-body">
    {
      locale === 'es'
        ? spanishParagraphs.map((paragraph) => <p>{paragraph}</p>)
        : <Content />
    }
  </section>

  <a class="author-item-enquiry" href={enquiryHref}>{enquiryLabel}</a>
</article>

<style>
  :global(.site-shell > main) {
    max-width: none;
    padding: clamp(7rem, 13vh, 8.5rem) clamp(1rem, 4vw, 3rem) 0;
    width: 100%;
  }

  .author-item-detail {
    --author-item-back-font-size: clamp(0.82rem, 1vw, 0.98rem);
    --author-item-back-gap: clamp(2rem, 5vw, 4rem);

    color: #000000;
    margin: 0 auto;
    max-width: 58rem;
    min-height: calc(100vh - clamp(7rem, 13vh, 8.5rem));
    padding-bottom: clamp(2rem, 6vh, 4rem);
    width: 100%;
  }

  .author-item-back {
    color: #691b17;
    display: inline-block;
    font-size: var(--author-item-back-font-size);
    font-weight: 200;
    line-height: 1;
    margin-bottom: var(--author-item-back-gap);
    transition: color 180ms ease;
  }

  .author-item-back:focus-visible,
  .author-item-back:hover {
    color: #000000;
  }

  .author-item-back:focus-visible {
    outline: 1px solid #691b17;
    outline-offset: 0.35rem;
  }

  .author-item-header h1 {
    font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    font-size: clamp(1.35rem, 2.1vw, 2.15rem);
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1;
    margin: 0;
  }

  .author-item-header dl {
    display: grid;
    gap: 0.65rem;
    margin: 1.6rem 0 0;
  }

  .author-item-header div {
    display: grid;
    gap: 0.2rem;
  }

  .author-item-header dt,
  .author-item-header dd,
  .author-item-body,
  .author-item-enquiry {
    font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    letter-spacing: 0;
  }

  .author-item-header dt {
    color: #919191;
    font-size: 0.68rem;
    font-weight: 200;
    line-height: 1;
  }

  .author-item-header dd {
    font-size: 0.88rem;
    font-weight: 300;
    line-height: 1.25;
    margin: 0;
  }

  .author-item-body {
    font-size: 1rem;
    font-weight: 200;
    line-height: 1.72;
    margin-top: clamp(1.6rem, 4vw, 2.8rem);
  }

  .author-item-body :global(p),
  .author-item-body p {
    margin: 0 0 1.18rem;
  }

  .author-item-body :global(p:last-child),
  .author-item-body p:last-child {
    margin-bottom: 0;
  }

  .author-item-enquiry {
    color: #691b17;
    display: inline-block;
    font-size: var(--author-item-back-font-size);
    font-weight: 200;
    line-height: 1;
    margin-top: clamp(1.8rem, 5vw, 3.5rem);
    transition: color 180ms ease;
    width: fit-content;
  }

  .author-item-enquiry:focus-visible,
  .author-item-enquiry:hover {
    color: #000000;
  }

  .author-item-enquiry:focus-visible {
    outline: 1px solid #691b17;
    outline-offset: 0.35rem;
  }

  @media (max-width: 760px) {
    :global(.site-shell > main) {
      padding-top: 6.5rem;
    }

    .author-item-header h1 {
      font-size: clamp(0.95rem, 3.8vw, 1.25rem);
    }

    .author-item-body {
      font-size: var(--author-item-back-font-size);
    }
  }

  @media (max-width: 560px) {
    .author-item-detail {
      --author-item-back-font-size: 0.72rem;
    }

    .author-item-header dt {
      font-size: 0.6rem;
    }

    .author-item-header dd {
      font-size: var(--author-item-back-font-size);
    }
  }
</style>
