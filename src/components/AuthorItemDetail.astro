---
import { render } from 'astro:content';
import type { AuthorItem } from '../lib/authorItems';
import { getAuthorItemDetailMetadata, getAuthorItemTitle } from '../lib/authorItems';

interface Props {
  backHref: string;
  backLabel: string;
  item: AuthorItem;
  locale?: 'en' | 'es';
}

const { backHref, backLabel, item, locale = 'en' } = Astro.props;
const metadata = getAuthorItemDetailMetadata(item, locale);
const title = getAuthorItemTitle(item, locale);
const imageAlt = locale === 'es'
  ? item.data.spanishImageAlt ?? `Imagen que acompaña a ${title}`
  : item.data.imageAlt ?? `Image accompanying ${title}`;
const { Content } = await render(item);
const spanishParagraphs = (item.data.spanishBody ?? '')
  .split(/\n{2,}/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
const enquiryEmail = 'sebastian.samana@icloud.com';
const enquiryDetails = metadata.map((item) => item.value).join(' / ');
const enquiryBody = [
  locale === 'es' ? 'Hola Sebastian,' : 'Hello Sebastian,',
  '',
  locale === 'es'
    ? 'Me gustaría consultar más sobre este texto:'
    : 'I would like to enquire further about this text:',
  '',
  title,
  ...(enquiryDetails ? [enquiryDetails] : []),
  '',
  locale === 'es' ? 'Mi consulta:' : 'My query:',
].join('\n');
const enquiryHref = `mailto:${enquiryEmail}?subject=${encodeURIComponent(
  locale === 'es' ? `Consulta sobre ${title}` : `Enquiry about ${title}`,
)}&body=${encodeURIComponent(enquiryBody)}`;
const enquiryLabel = locale === 'es' ? 'Consultar más' : 'Enquire further';
---

<article
  class:list={['author-item-detail', { 'author-item-detail--with-image': Boolean(item.data.image) }]}
  data-author-item-detail
  data-varelism-route-reveal
>
  <a class="author-item-back" href={backHref}>{backLabel}</a>

  <div class="author-item-layout">
    <header class="author-item-header">
      <h1>{title}</h1>
      {
        metadata.length > 0 && (
          <dl>
            {
              metadata.map((item) => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))
            }
          </dl>
        )
      }
    </header>

    <div class="author-item-content">
      {
        item.data.image && (
          <img
            class:list={['author-item-image', { 'author-item-image--outlined': item.data.imageOutline }]}
            src={item.data.image}
            width={item.data.imageWidth}
            height={item.data.imageHeight}
            alt={imageAlt}
            decoding="async"
            draggable="false"
            data-content-guard="image"
          />
        )
      }

      <section class="author-item-body" data-content-guard="text">
        {
          locale === 'es'
            ? spanishParagraphs.map((paragraph) => (
                <p>
                  {
                    paragraph.split(/\r?\n/).map((line, index) => (
                      <>
                        {index > 0 && <br />}
                        {line}
                      </>
                    ))
                  }
                </p>
              ))
            : <Content />
        }
      </section>
    </div>

    <footer class="author-item-footer">
      <a class="author-item-enquiry" href={enquiryHref} data-author-item-content-end>{enquiryLabel}</a>
      <button class="author-item-top" type="button" data-author-back-to-top hidden>
        {locale === 'es' ? 'Volver arriba' : 'Back to top'}
      </button>
    </footer>
  </div>
</article>

<script>
  (() => {
    const setupAuthorBackToTop = () => {
      document.querySelectorAll('[data-author-item-detail]').forEach((detail) => {
        if (!(detail instanceof HTMLElement) || detail.dataset.authorBackToTopReady === 'true') return;

        const contentEnd = detail.querySelector('[data-author-item-content-end]');
        const button = detail.querySelector('[data-author-back-to-top]');

        if (!(contentEnd instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;

        detail.dataset.authorBackToTopReady = 'true';

        const syncVisibility = () => {
          const contentBottom = contentEnd.getBoundingClientRect().bottom + window.scrollY;
          const scrollToContentEnd = contentBottom - window.innerHeight;
          button.hidden = scrollToContentEnd <= window.innerHeight * 0.5;
        };

        button.addEventListener('click', () => {
          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          window.scrollTo({
            behavior: prefersReducedMotion ? 'auto' : 'smooth',
            top: 0,
          });
        });
        window.addEventListener('resize', syncVisibility, { passive: true });
        detail.querySelectorAll('img').forEach((image) => {
          if (image.complete) return;
          image.addEventListener('load', syncVisibility, { once: true });
          image.addEventListener('error', syncVisibility, { once: true });
        });
        document.fonts?.ready.then(syncVisibility);
        syncVisibility();
      });
    };

    setupAuthorBackToTop();
    document.addEventListener('astro:page-load', setupAuthorBackToTop);
  })();
</script>

<style>
  :global(.site-shell > main) {
    --author-item-top-offset: clamp(7rem, 13vh, 8.5rem);
    max-width: none;
    padding: var(--author-item-top-offset) clamp(1rem, 4vw, 3rem) 0;
    width: 100%;
  }

  .author-item-detail {
    --author-item-back-gap: clamp(2rem, 5vw, 4rem);

    color: #000000;
    margin: 0 auto;
    max-width: 58rem;
    min-height: calc(100vh - clamp(7rem, 13vh, 8.5rem));
    padding-bottom: clamp(2rem, 6vh, 4rem);
    width: 100%;
  }

  .author-item-back {
    color: #691b17;
    display: inline-block;
    font-size: var(--varelism-body-font-size);
    font-weight: 200;
    line-height: 1;
    margin-bottom: var(--author-item-back-gap);
    transition: color 180ms ease;
  }

  .author-item-back:focus-visible,
  .author-item-back:hover {
    color: #000000;
  }

  .author-item-back:focus-visible {
    outline: 1px solid #691b17;
    outline-offset: 0.35rem;
  }

  .author-item-header h1 {
    font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    font-size: clamp(1.35rem, 2.1vw, 2.15rem);
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1;
    margin: 0;
    opacity: 1;
  }

  .author-item-header dl {
    display: grid;
    gap: 0.65rem;
    margin: var(--author-item-back-gap) 0 0;
  }

  .author-item-header div {
    display: grid;
    gap: 0.1rem;
  }

  .author-item-header dt,
  .author-item-header dd,
  .author-item-body,
  .author-item-enquiry,
  .author-item-top {
    font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    letter-spacing: 0;
  }

  .author-item-header dt {
    color: #919191;
    font-size: 0.68rem;
    font-weight: 200;
    line-height: 1;
  }

  .author-item-header dd {
    color: #919191;
    font-size: var(--varelism-body-font-size);
    font-weight: 200;
    line-height: 1.25;
    margin: 0;
  }

  .author-item-layout,
  .author-item-content {
    display: contents;
  }

  .author-item-image {
    display: block;
    height: auto;
    margin-top: clamp(1.6rem, 4vw, 2.8rem);
    max-width: 100%;
    width: min(100%, 32rem);
  }

  .author-item-image--outlined {
    outline: 1px solid #f2f2f2;
  }

  .author-item-body {
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    font-size: var(--varelism-body-font-size);
    font-weight: 200;
    line-height: 1.72;
    margin-top: clamp(1.6rem, 4vw, 2.8rem);
    user-select: none;
  }

  .author-item-body :global(p),
  .author-item-body p {
    margin: 0 0 1.18rem;
  }

  .author-item-body :global(p:last-child),
  .author-item-body p:last-child {
    margin-bottom: 0;
  }

  .author-item-footer {
    align-items: baseline;
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    justify-content: space-between;
    margin-top: clamp(1.8rem, 5vw, 3.5rem);
  }

  .author-item-enquiry,
  .author-item-top {
    color: #691b17;
    font-size: var(--varelism-body-font-size);
    font-weight: 200;
    line-height: 1;
    transition: color 180ms ease;
    width: fit-content;
  }

  .author-item-enquiry:focus-visible,
  .author-item-enquiry:hover,
  .author-item-top:focus-visible,
  .author-item-top:hover {
    color: #000000;
  }

  .author-item-enquiry:focus-visible,
  .author-item-top:focus-visible {
    outline: 1px solid #691b17;
    outline-offset: 0.35rem;
  }

  .author-item-top {
    appearance: none;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
  }

  .author-item-top[hidden] {
    display: none;
  }

  @media (min-width: 960px) and (orientation: landscape), (min-width: 1200px) {
    .author-item-detail--with-image {
      --author-item-viewport-height: 100vh;
      --author-item-image-max-height: calc(
        var(--author-item-viewport-height) - var(--author-item-top-offset) -
          var(--varelism-body-font-size) - var(--author-item-back-gap) - 1rem
      );
      max-width: 76rem;
    }

    .author-item-detail--with-image .author-item-layout {
      column-gap: clamp(1.5rem, 4vw, 3rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr) 20rem;
      grid-template-rows: auto auto minmax(min-content, 1fr);
    }

    .author-item-detail--with-image .author-item-header {
      align-self: start;
      grid-column: 2;
      grid-row: 1;
      min-width: 0;
    }

    .author-item-detail--with-image .author-item-header h1,
    .author-item-detail--with-image .author-item-header dt,
    .author-item-detail--with-image .author-item-header dd,
    .author-item-detail--with-image .author-item-enquiry {
      font-family: 'SF Pro Display Latin', var(--font-sans);
    }

    .author-item-detail--with-image .author-item-image {
      align-self: start;
      grid-column: 1;
      grid-row: 1 / 4;
      justify-self: start;
      margin-top: 0;
      max-height: var(--author-item-image-max-height);
      max-width: 100%;
      width: auto;
    }

    .author-item-detail--with-image .author-item-body {
      align-self: start;
      grid-column: 2;
      grid-row: 2;
      margin-top: clamp(1.6rem, 4vw, 2.8rem);
      min-width: 0;
    }

    .author-item-detail--with-image .author-item-footer {
      align-self: start;
      flex-wrap: wrap;
      grid-column: 2;
      grid-row: 3;
      margin-top: clamp(1.6rem, 4vw, 2.8rem);
    }

    @supports (height: 100svh) {
      .author-item-detail--with-image {
        --author-item-viewport-height: 100svh;
      }
    }
  }

  @media (max-width: 760px) {
    :global(.site-shell > main) {
      --author-item-top-offset: 6.5rem;
      padding-top: var(--author-item-top-offset);
    }

    .author-item-header h1 {
      font-size: clamp(0.98rem, 3.8vw, 1.25rem);
    }

    .author-item-header h1 {
      font-family: 'SF Pro Display Thin', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
        'Helvetica Neue', Arial, sans-serif;
      font-weight: 200;
      opacity: 1;
    }
  }

  @media (max-width: 560px) {
    .author-item-header dt {
      font-size: 0.6rem;
    }
  }
</style>
