---
import BaseLayout from '../layouts/BaseLayout.astro';
import MathVisualisationBackground from '../components/MathVisualisationBackground.astro';

const sections = [
  { title: 'Writer', href: '/writer/' },
  { title: 'Architect', href: '/architect/' },
  { title: 'Painter', href: '/painter/' },
];
---

<BaseLayout
  title="Sebastian Samana"
  description="Writer, architect, and painter exploring literature, architecture, and visual art."
>
  <MathVisualisationBackground />
  <section class="triptych" aria-label="Samana sections">
    {sections.map((section) => (
      <div class="triptych-item">
        <a class="triptych-link" href={section.href}>
          <h1>{section.title}</h1>
        </a>
      </div>
    ))}
  </section>
  <script src="/scripts/home-column-interactions.js?v=20260711-responsive-column-hover" defer data-astro-rerun></script>
</BaseLayout>

<style>
  :global(.site-shell > main) {
    display: grid;
    max-width: none;
    min-height: var(--home-viewport-height, 100svh);
    padding: 0;
    place-items: center;
  }

  .triptych {
    --column-hover-ease: var(--varelism-column-hover-ease);
    --column-hover-ms: var(--varelism-column-hover-ms);
    align-items: center;
    display: grid;
    gap: clamp(1.5rem, 6vw, 7rem);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    justify-items: center;
    margin: 0 auto;
    min-height: var(--home-viewport-height, 100svh);
    padding: clamp(1.5rem, 4vh, 3rem) clamp(1.25rem, 6vw, 6rem);
    position: relative;
    width: min(100%, 1280px);
    z-index: 1;
  }

  .triptych-item {
    align-items: center;
    color: #000000;
    display: flex;
    flex-direction: column;
    min-width: 0;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    user-select: none;
    width: 100%;
  }

  .triptych-link {
    color: inherit;
    display: block;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  h1 {
    color: currentColor;
    font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    font-size: clamp(1.35rem, 2.1vw, 2.15rem);
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1;
    margin: 0;
    text-align: center;
    transition: color var(--column-hover-ms) var(--column-hover-ease);
  }

  .triptych-item.is-column-hovering h1,
  .triptych-item.is-column-pressing h1,
  .triptych-item.is-column-navigating h1 {
    color: #691b17;
  }

  .triptych-item:focus-within h1 {
    color: #691b17;
  }

  .triptych-link:focus-visible h1 {
    color: #691b17;
  }

  .triptych-link:focus-visible {
    outline: 1px solid #691b17;
    outline-offset: 0.75rem;
  }

  .triptych-link:active h1 {
    color: #691b17;
  }

  @media (hover: hover) and (pointer: fine) {
    .triptych-link:hover h1 {
      color: #691b17;
    }
  }

  @media (max-width: 720px) {
    .triptych {
      gap: clamp(1rem, 4vw, 2rem);
      padding-left: 1rem;
      padding-right: 1rem;
    }

    h1 {
      font-size: clamp(0.95rem, 3.8vw, 1.25rem);
    }
  }

  @media (max-width: 430px) {
    .triptych {
      gap: 0.75rem;
    }
  }
</style>
