---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  { title: 'Author', href: '/author/' },
  { title: 'Architect', href: '/architect/' },
  { title: 'Artist', href: '/artist/' },
];
---

<BaseLayout title="Varelism" description="Author, architect, and artist.">
  <section class="triptych" aria-label="Varelism sections">
    <canvas class="triptych-field" data-varelism-home-field aria-hidden="true"></canvas>
    {sections.map((section) => (
      <div class="triptych-item">
        <a class="triptych-link" href={section.href}>
          <h1>{section.title}</h1>
        </a>
        <span class="column-stack" aria-hidden="true">
          <img
            class="column column-base"
            src="/images/Home_Page_Column.png"
            alt=""
            width="720"
            height="1290"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <img
            class="column column-hover"
            src="/images/Home_Page_Column_Cursor.png"
            alt=""
            width="720"
            height="1290"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </span>
      </div>
    ))}
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const setupColumnFootprintHitboxes = () => {
      document.querySelectorAll('.triptych-item').forEach((item) => {
        const link = item.querySelector('.triptych-link');
        const stack = item.querySelector('.column-stack');
        const image = item.querySelector('.column-base');

        if (
          !(item instanceof HTMLElement) ||
          !(link instanceof HTMLAnchorElement) ||
          !(stack instanceof HTMLElement) ||
          !(image instanceof HTMLImageElement) ||
          stack.dataset.columnFootprintHitboxReady === 'true'
        ) {
          return;
        }

        stack.dataset.columnFootprintHitboxReady = 'true';

        const alphaThreshold = 16;
        const backgroundThreshold = 250;
        const clickMoveTolerance = 10;
        const coarsePointerQuery = '(hover: none), (pointer: coarse)';
        let context = null;
        let naturalWidth = 0;
        let naturalHeight = 0;
        let pendingColumnClick = null;
        let pointerStart = null;
        let clearGroupTimer = 0;

        const isCoarsePointer = () => Boolean(window.matchMedia?.(coarsePointerQuery)?.matches);

        const setGroupHitState = (isHit) => {
          window.clearTimeout(clearGroupTimer);
          clearGroupTimer = 0;
          item.classList.toggle('is-column-hit', isHit);
        };

        const setColumnHitState = (isHit) => {
          setGroupHitState(isHit);
          stack.style.cursor = isHit ? 'pointer' : '';
        };

        const clearColumnHitState = () => {
          setGroupHitState(false);
          stack.style.cursor = '';
        };

        const scheduleGroupClear = () => {
          window.clearTimeout(clearGroupTimer);
          clearGroupTimer = window.setTimeout(clearColumnHitState, 80);
        };

        const buildHitCanvas = () => {
          if (!image.naturalWidth || !image.naturalHeight || context) return;

          naturalWidth = image.naturalWidth;
          naturalHeight = image.naturalHeight;

          const canvas = document.createElement('canvas');
          canvas.width = naturalWidth;
          canvas.height = naturalHeight;

          const nextContext = canvas.getContext('2d', { willReadFrequently: true });
          if (!nextContext) return;

          nextContext.drawImage(image, 0, 0, naturalWidth, naturalHeight);
          context = nextContext;
          flushPendingColumnClick();
        };

        const isPointInsideImageRect = (point) => {
          const rect = image.getBoundingClientRect();

          return (
            rect.width > 0 &&
            rect.height > 0 &&
            point.clientX >= rect.left &&
            point.clientX <= rect.right &&
            point.clientY >= rect.top &&
            point.clientY <= rect.bottom
          );
        };

        const isColumnPixel = (event) => {
          if (!isCoarsePointer()) {
            buildHitCanvas();
          }

          if (!context || !naturalWidth || !naturalHeight) return false;

          const rect = image.getBoundingClientRect();

          if (
            rect.width <= 0 ||
            rect.height <= 0 ||
            event.clientX < rect.left ||
            event.clientX > rect.right ||
            event.clientY < rect.top ||
            event.clientY > rect.bottom
          ) {
            return false;
          }

          const x = Math.min(
            naturalWidth - 1,
            Math.max(0, Math.floor(((event.clientX - rect.left) / rect.width) * naturalWidth)),
          );
          const y = Math.min(
            naturalHeight - 1,
            Math.max(0, Math.floor(((event.clientY - rect.top) / rect.height) * naturalHeight)),
          );
          const [red, green, blue, alpha] = context.getImageData(x, y, 1, 1).data;

          return (
            alpha > alphaThreshold &&
            !(red > backgroundThreshold && green > backgroundThreshold && blue > backgroundThreshold)
          );
        };

        const getPointerDistance = (event) => {
          if (!pointerStart) return 0;

          return Math.hypot(event.clientX - pointerStart.x, event.clientY - pointerStart.y);
        };

        const flushPendingColumnClick = () => {
          if (!pendingColumnClick || !context) return;

          const pendingEvent = pendingColumnClick;
          pendingColumnClick = null;

          if (isColumnPixel(pendingEvent)) {
            link.click();
          }
        };

        const prepareFinePointerHitCanvas = () => {
          if (isCoarsePointer()) return;

          if (image.complete) {
            buildHitCanvas();
          } else {
            image.addEventListener('load', buildHitCanvas, { once: true });
          }

          image.decode?.().then(buildHitCanvas).catch(() => {
            // The load event fallback above covers browsers that reject decode during navigation.
          });
        };

        const isImmediateColumnTap = (event) =>
          !context && isCoarsePointer() && isPointInsideImageRect(event);

        prepareFinePointerHitCanvas();

        stack.addEventListener('pointermove', (event) => {
          setColumnHitState(isColumnPixel(event));
        });

        stack.addEventListener('pointerdown', (event) => {
          const isHit = isImmediateColumnTap(event) || isColumnPixel(event);

          pointerStart = isHit
            ? {
                id: event.pointerId,
                x: event.clientX,
                y: event.clientY,
              }
            : null;
          setColumnHitState(isHit);
        });

        stack.addEventListener('pointerup', (event) => {
          if (!pointerStart || pointerStart.id !== event.pointerId) return;

          setColumnHitState(isImmediateColumnTap(event) || isColumnPixel(event));
        });

        stack.addEventListener('pointercancel', () => {
          pointerStart = null;
          clearColumnHitState();
        });

        stack.addEventListener('pointerleave', () => {
          pointerStart = null;
          scheduleGroupClear();
        });

        stack.addEventListener('click', (event) => {
          const movedPastClick = getPointerDistance(event) > clickMoveTolerance;

          if (!movedPastClick && (isImmediateColumnTap(event) || isColumnPixel(event))) {
            event.preventDefault();
            event.stopPropagation();
            link.click();
          } else if (!movedPastClick && !context && isPointInsideImageRect(event)) {
            pendingColumnClick = {
              clientX: event.clientX,
              clientY: event.clientY,
            };
          }

          pointerStart = null;
        });

        const setLinkHitState = () => {
          setGroupHitState(true);
          stack.style.cursor = '';
        };

        link.addEventListener('pointerenter', setLinkHitState);
        link.addEventListener('pointermove', setLinkHitState);
        link.addEventListener('pointerdown', setLinkHitState);
        link.addEventListener('mouseenter', setLinkHitState);
        link.addEventListener('mousemove', setLinkHitState);

        link.addEventListener('pointerleave', scheduleGroupClear);
        link.addEventListener('focus', () => setGroupHitState(true));
        link.addEventListener('blur', scheduleGroupClear);
      });
    };

    setupColumnFootprintHitboxes();

    if (window.__varelismHomeColumnFootprintHitboxesReady) return;

    window.__varelismHomeColumnFootprintHitboxesReady = true;
    document.addEventListener('astro:page-load', setupColumnFootprintHitboxes);
  })();
</script>

<script is:inline>
  (() => {
    const canvasSelector = '[data-varelism-home-field]';
    const cleanupKey = '__varelismHomeQuadraticFieldCleanup';
    const listenerKey = '__varelismHomeQuadraticFieldListenersReady';

    const createRandom = (seed) => {
      let state = seed >>> 0;

      return () => {
        state += 0x6d2b79f5;
        let value = state;
        value = Math.imul(value ^ (value >>> 15), value | 1);
        value ^= value + Math.imul(value ^ (value >>> 7), value | 61);
        return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
      };
    };

    const setupQuadraticField = () => {
      const canvas = document.querySelector(canvasSelector);

      if (!(canvas instanceof HTMLCanvasElement)) {
        window[cleanupKey]?.();
        window[cleanupKey] = null;
        return;
      }

      if (canvas.dataset.quadraticFieldReady === 'true') return;

      window[cleanupKey]?.();
      canvas.dataset.quadraticFieldReady = 'true';

      const section = canvas.closest('.triptych');
      const context = canvas.getContext('2d', {
        alpha: true,
        desynchronized: true,
      });

      if (!(section instanceof HTMLElement) || !context) return;

      const pyStrangeParameterStrings = [
        'CRQVRWPKCDAG',
        'DNZRSOHOKLWZ',
        'SJDRDCTQGMSE',
        'TTEGUCXPKWQA',
        'GHLXBQLZSBSH',
        'VCJNAUKPUEHZ',
        'OBWUDMLGDZFR',
        'IITJEOIDYHFG',
        'MBTCOFSUBSUD',
        'AGWXDCUKEANF',
      ];
      const mutationRadius = 0.018;
      const randomSeed = Math.floor(Math.random() * 4294967296) >>> 0;
      const random = createRandom(randomSeed || 1);

      const letterToCoefficient = (letter) => -1.2 + (letter.charCodeAt(0) - 65) * 0.1;
      const iterateMap = (x, y, MX, MY) => ({
        x:
          MX[0] + MX[1] * x + MX[2] * x * x + MX[3] * x * y + MX[4] * y + MX[5] * y * y,
        y:
          MY[0] + MY[1] * x + MY[2] * x * x + MY[3] * x * y + MY[4] * y + MY[5] * y * y,
      });
      const buildPreset = (parameterString, shouldMutate = true) => {
        const values = Array.from(parameterString, (letter) => {
          const base = letterToCoefficient(letter);
          return shouldMutate ? base + (random() * 2 - 1) * mutationRadius : base;
        });

        return {
          burnIn: 560,
          centerX: 0,
          centerY: 0,
          MX: values.slice(0, 6),
          MY: values.slice(6, 12),
          parameterString,
          rangeX: 1,
          rangeY: 1,
        };
      };

      const validatePreset = (preset) => {
        let x = 0.1;
        let y = 0.1;
        let minX = Infinity;
        let maxX = -Infinity;
        let minY = Infinity;
        let maxY = -Infinity;
        const diversityBins = new Set();

        for (let index = 0; index < 2600; index += 1) {
          const next = iterateMap(x, y, preset.MX, preset.MY);
          x = next.x;
          y = next.y;

          if (!Number.isFinite(x) || !Number.isFinite(y) || Math.abs(x) > 10 || Math.abs(y) > 10) {
            return false;
          }

          if (index > 220 && index <= 520) {
            diversityBins.add(`${Math.round(x * 48)},${Math.round(y * 48)}`);
          }

          if (index > preset.burnIn) {
            minX = Math.min(minX, x);
            maxX = Math.max(maxX, x);
            minY = Math.min(minY, y);
            maxY = Math.max(maxY, y);
          }
        }

        const rangeX = maxX - minX;
        const rangeY = maxY - minY;

        if (
          diversityBins.size < 62 ||
          !Number.isFinite(rangeX) ||
          !Number.isFinite(rangeY) ||
          rangeX < 0.34 ||
          rangeY < 0.34
        ) {
          return false;
        }

        preset.centerX = (minX + maxX) / 2;
        preset.centerY = (minY + maxY) / 2;
        preset.rangeX = Math.max(rangeX, 0.8);
        preset.rangeY = Math.max(rangeY, 0.8);

        return true;
      };

      const selectPreset = () => {
        for (let attempt = 0; attempt < 24; attempt += 1) {
          const parameterString =
            pyStrangeParameterStrings[
              Math.floor(random() * pyStrangeParameterStrings.length)
            ] ?? pyStrangeParameterStrings[0];
          const preset = buildPreset(parameterString);

          if (validatePreset(preset)) return preset;
        }

        const fallback = buildPreset('CRQVRWPKCDAG', false);
        validatePreset(fallback);
        return fallback;
      };

      const selectedPreset = selectPreset();
      const coefficients = {
        MX: [...selectedPreset.MX],
        MY: [...selectedPreset.MY],
      };
      const safeBound = 10;
      const driftPhase = random() * Math.PI * 2;
      let width = 0;
      let height = 0;
      let dpr = 1;
      let isCompact = false;
      let iterationsPerFrame = 12;
      let maxTrail = 1600;
      let dotSize = 0.9;
      let fieldScale = 1;
      let resizeFrameId = 0;
      let frameId = 0;
      let isRunning = false;
      let orbit = null;
      const trail = [];

      const seedOrbit = () => {
        orbit = {
          age: 0,
          burn: selectedPreset.burnIn + Math.floor(random() * 96),
          life: 6400 + Math.floor(random() * 1800),
          x: 0.1 + (random() * 2 - 1) * 0.018,
          y: 0.1 + (random() * 2 - 1) * 0.018,
        };
      };

      const trimTrail = () => {
        if (trail.length > maxTrail) {
          trail.splice(0, trail.length - maxTrail);
        }
      };

      const stepOrbit = () => {
        if (!orbit) {
          seedOrbit();
        }

        const x = orbit.x;
        const y = orbit.y;
        const next = iterateMap(x, y, coefficients.MX, coefficients.MY);
        const xNext = next.x;
        const yNext = next.y;

        if (
          !Number.isFinite(xNext) ||
          !Number.isFinite(yNext) ||
          Math.abs(xNext) > safeBound ||
          Math.abs(yNext) > safeBound ||
          orbit.age > orbit.life
        ) {
          seedOrbit();
          return null;
        }

        orbit.x = xNext;
        orbit.y = yNext;
        orbit.age += 1;

        if (orbit.age <= orbit.burn) {
          return null;
        }

        return {
          tone: random(),
          x: xNext,
          y: yNext,
        };
      };

      const projectPoint = (point, time) => {
        const driftX = Math.sin(time * 0.000023 + driftPhase) * width * (isCompact ? 0.02 : 0.028);
        const driftY =
          Math.cos(time * 0.000019 + driftPhase * 0.7) * height * (isCompact ? 0.014 : 0.018);
        const centerX = width * (isCompact ? 0.62 : 0.53) + driftX;
        const centerY = height * (isCompact ? 0.67 : 0.58) + driftY;

        return {
          x: centerX + (point.x - selectedPreset.centerX) * fieldScale,
          y: centerY + (point.y - selectedPreset.centerY) * fieldScale * 0.88,
        };
      };

      const getTrailColor = (point, alpha) => {
        if (point.tone < 0.018) return `rgba(105, 27, 23, ${alpha * 0.82})`;
        if (point.tone < 0.28) return `rgba(27, 55, 67, ${alpha})`;
        if (point.tone < 0.72) return `rgba(112, 116, 116, ${alpha * 0.9})`;
        return `rgba(197, 198, 194, ${alpha * 0.78})`;
      };

      const drawTrail = (time) => {
        context.clearRect(0, 0, width, height);

        const length = trail.length;

        if (!length) return;

        const step = 1;
        const accentStart = Math.max(0, length - (isCompact ? 38 : 72));

        for (let index = 0; index < length; index += step) {
          const point = trail[index];
          const age = index / Math.max(1, length - 1);
          const projected = projectPoint(point, time);

          if (projected.x < -4 || projected.y < -4 || projected.x > width + 4 || projected.y > height + 4) {
            continue;
          }

          const recent = index >= accentStart ? (index - accentStart) / Math.max(1, length - accentStart) : 0;
          const alpha =
            (isCompact ? 0.036 : 0.022) +
            Math.pow(age, isCompact ? 3 : 3.4) * (isCompact ? 0.36 : 0.27) +
            recent * (isCompact ? 0.22 : 0.15);

          context.fillStyle = getTrailColor(point, alpha);
          context.fillRect(
            Math.round(projected.x * dpr) / dpr,
            Math.round(projected.y * dpr) / dpr,
            dotSize,
            dotSize,
          );
        }

        const head = trail[length - 1];

        if (!head) return;

        const projectedHead = projectPoint(head, time);

        context.fillStyle = 'rgba(27, 55, 67, 0.24)';
        context.fillRect(
          Math.round(projectedHead.x * dpr) / dpr,
          Math.round(projectedHead.y * dpr) / dpr,
          dotSize + 0.5,
          dotSize + 0.5,
        );
      };

      const prefillTrail = () => {
        trail.length = 0;
        seedOrbit();

        const warmIterations = selectedPreset.burnIn + 160;

        for (let index = 0; index < warmIterations; index += 1) {
          stepOrbit();
        }

        const targetLength = Math.floor(maxTrail * 0.72);

        for (let index = 0; index < targetLength; index += 1) {
          const point = stepOrbit();

          if (point) trail.push(point);
        }

        trimTrail();
      };

      const resizeCanvas = () => {
        const rect = canvas.getBoundingClientRect();
        const nextWidth = Math.max(1, Math.round(rect.width));
        const nextHeight = Math.max(1, Math.round(rect.height));
        const nextDpr = Math.min(2, Math.max(1, window.devicePixelRatio || 1));
        const nextCompact = nextWidth < 720;
        const sizeChanged = nextWidth !== width || nextHeight !== height || nextDpr !== dpr;

        width = nextWidth;
        height = nextHeight;
        dpr = nextDpr;
        isCompact = nextCompact;
        iterationsPerFrame = isCompact ? 5 : 7;
        maxTrail = isCompact ? 560 : 920;
        dotSize = isCompact ? 1.22 : 1.22;
        fieldScale = Math.min(
          (width * (isCompact ? 0.78 : 0.84)) / selectedPreset.rangeX,
          (height * (isCompact ? 0.48 : 0.66)) / selectedPreset.rangeY,
        );

        if (sizeChanged) {
          canvas.width = Math.ceil(width * dpr);
          canvas.height = Math.ceil(height * dpr);
          context.setTransform(dpr, 0, 0, dpr, 0, 0);
          context.clearRect(0, 0, width, height);
          prefillTrail();
        } else {
          trimTrail();
        }
      };

      const queueResize = () => {
        if (resizeFrameId) return;

        resizeFrameId = window.requestAnimationFrame(() => {
          resizeFrameId = 0;
          resizeCanvas();
        });
      };

      const render = (time = 0) => {
        frameId = 0;

        if (!isRunning || document.hidden || !section.isConnected) return;

        for (let index = 0; index < iterationsPerFrame; index += 1) {
          const point = stepOrbit();

          if (point) trail.push(point);
        }

        trimTrail();
        drawTrail(time);
        frameId = window.requestAnimationFrame(render);
      };

      const start = () => {
        if (isRunning || document.hidden) return;

        isRunning = true;
        resizeCanvas();
        frameId = window.requestAnimationFrame(render);
      };

      const stop = () => {
        isRunning = false;

        if (frameId) {
          window.cancelAnimationFrame(frameId);
          frameId = 0;
        }
      };

      const handleVisibility = () => {
        if (document.hidden) {
          stop();
        } else {
          start();
        }
      };

      const resizeObserver = window.ResizeObserver ? new ResizeObserver(queueResize) : null;

      resizeObserver?.observe(section);
      window.addEventListener('resize', queueResize, { passive: true });
      document.addEventListener('visibilitychange', handleVisibility);

      window[cleanupKey] = () => {
        stop();
        resizeObserver?.disconnect();
        window.removeEventListener('resize', queueResize);
        document.removeEventListener('visibilitychange', handleVisibility);

        if (resizeFrameId) {
          window.cancelAnimationFrame(resizeFrameId);
          resizeFrameId = 0;
        }

        delete canvas.dataset.quadraticFieldReady;
      };

      start();
    };

    setupQuadraticField();

    if (window[listenerKey]) return;

    window[listenerKey] = true;
    document.addEventListener('astro:before-swap', () => {
      window[cleanupKey]?.();
      window[cleanupKey] = null;
    });
    document.addEventListener('astro:page-load', setupQuadraticField);
  })();
</script>

<style>
  :global(.site-shell > main) {
    display: grid;
    max-width: none;
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    padding: 0;
    place-items: center;
  }

  .triptych {
    align-items: center;
    display: grid;
    gap: clamp(1.5rem, 6vw, 7rem);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    justify-items: center;
    margin: 0 auto;
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    padding: clamp(1.5rem, 4vh, 3rem) clamp(1.25rem, 6vw, 6rem);
    position: relative;
    width: min(100%, 1280px);
  }

  .triptych-field {
    display: block;
    height: 100%;
    left: 50%;
    opacity: 0.88;
    pointer-events: none;
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    width: 100vw;
    z-index: 0;
  }

  .triptych-item {
    align-items: center;
    color: #000000;
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.8vh, 1.25rem);
    min-width: 0;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    position: relative;
    user-select: none;
    width: 100%;
    z-index: 1;
  }

  .triptych-link {
    color: inherit;
    display: block;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  h1 {
    color: currentColor;
    font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    font-size: clamp(1.35rem, 2.1vw, 2.15rem);
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1;
    margin: 0;
    text-align: center;
    transition: color 180ms ease;
  }

  .column-stack {
    display: grid;
    max-width: 100%;
    position: relative;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    width: clamp(6.25rem, 17vw, 13.25rem);
  }

  .column {
    display: block;
    grid-area: 1 / 1;
    height: auto;
    max-width: 100%;
    pointer-events: none;
    width: 100%;
  }

  .column-hover {
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .triptych-item.is-column-hit h1 {
    color: #691b17;
  }

  .triptych-item.is-column-hit .column-hover {
    opacity: 1;
  }

  .triptych-item:focus-within h1 {
    color: #691b17;
  }

  .triptych-item:focus-within .column-hover {
    opacity: 1;
  }

  .triptych-link:focus-visible h1 {
    color: #691b17;
  }

  .triptych-link:focus-visible {
    outline: 1px solid #691b17;
    outline-offset: 0.75rem;
  }

  .triptych-link:hover h1 {
    color: #691b17;
  }

  .triptych-link:hover + .column-stack .column-hover {
    opacity: 1;
  }

  .triptych-link:active h1 {
    color: #691b17;
  }

  .triptych-link:active + .column-stack .column-hover {
    opacity: 1;
  }

  @media (max-width: 720px) {
    .triptych {
      gap: clamp(1rem, 4vw, 2rem);
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .triptych-item {
      gap: 0.8rem;
    }

    h1 {
      font-size: clamp(0.95rem, 3.8vw, 1.25rem);
    }

    .column-stack {
      width: clamp(4.25rem, 26vw, 7rem);
    }
  }

  @media (max-width: 430px) {
    .triptych {
      gap: 0.75rem;
    }
  }
</style>
