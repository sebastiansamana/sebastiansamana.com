---
import BaseLayout from '../layouts/BaseLayout.astro';
import MathVisualisationBackground from '../components/MathVisualisationBackground.astro';

const sections = [
  { title: 'Author', href: '/author/' },
  { title: 'Architect', href: '/architect/' },
  { title: 'Artist', href: '/artist/' },
];
---

<BaseLayout title="Varelism" description="Author, architect, and artist.">
  <MathVisualisationBackground />
  <section class="triptych" aria-label="Varelism sections">
    {sections.map((section) => (
      <div class="triptych-item">
        <a class="triptych-link" href={section.href}>
          <h1>{section.title}</h1>
        </a>
        <span class="column-stack" aria-hidden="true">
          <img
            class="column column-base"
            src="/images/Home_Page_Column_Transparent.png"
            alt=""
            width="613"
            height="1290"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <a class="column-hitbox column-hitbox--top" href={section.href} aria-hidden="true" tabindex="-1"></a>
          <a class="column-hitbox column-hitbox--cap" href={section.href} aria-hidden="true" tabindex="-1"></a>
          <a class="column-hitbox column-hitbox--shaft" href={section.href} aria-hidden="true" tabindex="-1"></a>
          <img
            class="column column-hover"
            src="/images/Home_Page_Column_Cursor_Transparent.png"
            alt=""
            width="613"
            height="1290"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </span>
      </div>
    ))}
  </section>
  <script src="/scripts/home-column-interactions.js?v=20260710-smooth-column-press" defer data-astro-rerun></script>
</BaseLayout>

<style>
  :global(.site-shell > main) {
    display: grid;
    max-width: none;
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    padding: 0;
    place-items: center;
  }

  .triptych {
    --column-hover-ease: cubic-bezier(0.22, 1, 0.36, 1);
    align-items: center;
    display: grid;
    gap: clamp(1.5rem, 6vw, 7rem);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    justify-items: center;
    margin: 0 auto;
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    padding: clamp(1.5rem, 4vh, 3rem) clamp(1.25rem, 6vw, 6rem);
    position: relative;
    width: min(100%, 1280px);
    z-index: 1;
  }

  .triptych-item {
    align-items: center;
    color: #000000;
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.8vh, 1.25rem);
    min-width: 0;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    user-select: none;
    width: 100%;
  }

  .triptych-link {
    color: inherit;
    display: block;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  h1 {
    color: currentColor;
    font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    font-size: clamp(1.35rem, 2.1vw, 2.15rem);
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1;
    margin: 0;
    text-align: center;
    transition: color 240ms var(--column-hover-ease);
  }

  .column-stack {
    display: grid;
    isolation: isolate;
    max-width: 100%;
    pointer-events: none;
    position: relative;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transform: translateZ(0);
    width: clamp(6.25rem, 17vw, 13.25rem);
  }

  .column {
    backface-visibility: hidden;
    display: block;
    grid-area: 1 / 1;
    height: auto;
    max-width: 100%;
    pointer-events: none;
    transition: opacity 260ms var(--column-hover-ease);
    width: 100%;
    will-change: opacity;
  }

  .column-base {
    opacity: 1;
    position: relative;
    z-index: 0;
  }

  .column-hover {
    backface-visibility: hidden;
    opacity: 0;
    pointer-events: none;
    position: relative;
    transform: translateZ(0);
    transition: opacity 260ms var(--column-hover-ease);
    will-change: opacity;
    z-index: 1;
  }

  .column-hitbox {
    cursor: pointer;
    display: block;
    pointer-events: auto;
    position: absolute;
    z-index: 2;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
  }

  .column-hitbox--top {
    height: 1.56%;
    left: 21.37%;
    top: 7.75%;
    width: 57.26%;
  }

  .column-hitbox--cap {
    height: 1.32%;
    left: 26.1%;
    top: 9.3%;
    width: 47.8%;
  }

  .column-hitbox--shaft {
    height: 83.88%;
    left: 32.63%;
    top: 10.54%;
    width: 34.42%;
  }

  .triptych-item:has(.column-hitbox:active) h1 {
    color: #691b17;
  }

  .triptych-item:has(.column-hitbox:active) .column-base,
  .triptych-item.is-column-hovering .column-base,
  .triptych-item.is-column-pressing .column-base,
  .triptych-item.is-column-navigating .column-base {
    opacity: 0;
  }

  .column-hitbox:active ~ .column-hover {
    opacity: 1;
  }

  .triptych-item.is-column-hovering h1,
  .triptych-item.is-column-pressing h1,
  .triptych-item.is-column-navigating h1 {
    color: #691b17;
  }

  .triptych-item.is-column-hovering .column-hover,
  .triptych-item.is-column-pressing .column-hover,
  .triptych-item.is-column-navigating .column-hover {
    opacity: 1;
  }

  .triptych-item:focus-within h1 {
    color: #691b17;
  }

  .triptych-item:focus-within .column-hover {
    opacity: 1;
  }

  .triptych-item:focus-within .column-base {
    opacity: 0;
  }

  .triptych-link:focus-visible h1 {
    color: #691b17;
  }

  .triptych-link:focus-visible {
    outline: 1px solid #691b17;
    outline-offset: 0.75rem;
  }

  .triptych-link:active h1 {
    color: #691b17;
  }

  .triptych-link:active + .column-stack .column-hover {
    opacity: 1;
  }

  .triptych-link:active + .column-stack .column-base {
    opacity: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .triptych-item:has(.column-hitbox:hover) h1 {
      color: #691b17;
    }

    .triptych-item:has(.column-hitbox:hover) .column-hover,
    .column-hitbox:hover ~ .column-hover {
      opacity: 1;
    }

    .triptych-item:has(.column-hitbox:hover) .column-base {
      opacity: 0;
    }

    .triptych-link:hover h1 {
      color: #691b17;
    }

    .triptych-link:hover + .column-stack .column-hover {
      opacity: 1;
    }

    .triptych-link:hover + .column-stack .column-base {
      opacity: 0;
    }
  }

  @media (max-width: 720px) {
    .triptych {
      gap: clamp(1rem, 4vw, 2rem);
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .triptych-item {
      gap: 0.8rem;
    }

    h1 {
      font-size: clamp(0.95rem, 3.8vw, 1.25rem);
    }

    .column-stack {
      width: clamp(4.25rem, 26vw, 7rem);
    }
  }

  @media (max-width: 430px) {
    .triptych {
      gap: 0.75rem;
    }
  }
</style>
