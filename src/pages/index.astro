---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  { title: 'Author', href: '/author/' },
  { title: 'Architect', href: '/architect/' },
  { title: 'Artist', href: '/artist/' },
];
---

<BaseLayout title="Varelism" description="Author, architect, and artist.">
  <section class="triptych" aria-label="Varelism sections">
    <canvas class="triptych-field" data-varelism-home-field aria-hidden="true"></canvas>
    {sections.map((section) => (
      <div class="triptych-item">
        <a class="triptych-link" href={section.href}>
          <h1>{section.title}</h1>
        </a>
        <span class="column-stack" aria-hidden="true">
          <img
            class="column column-base"
            src="/images/Home_Page_Column.png"
            alt=""
            width="720"
            height="1290"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <img
            class="column column-hover"
            src="/images/Home_Page_Column_Cursor.png"
            alt=""
            width="720"
            height="1290"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </span>
      </div>
    ))}
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const setupColumnFootprintHitboxes = () => {
      document.querySelectorAll('.triptych-item').forEach((item) => {
        const link = item.querySelector('.triptych-link');
        const stack = item.querySelector('.column-stack');
        const image = item.querySelector('.column-base');

        if (
          !(item instanceof HTMLElement) ||
          !(link instanceof HTMLAnchorElement) ||
          !(stack instanceof HTMLElement) ||
          !(image instanceof HTMLImageElement) ||
          stack.dataset.columnFootprintHitboxReady === 'true'
        ) {
          return;
        }

        stack.dataset.columnFootprintHitboxReady = 'true';

        const alphaThreshold = 16;
        const backgroundThreshold = 250;
        const clickMoveTolerance = 10;
        const coarsePointerQuery = '(hover: none), (pointer: coarse)';
        let context = null;
        let naturalWidth = 0;
        let naturalHeight = 0;
        let pendingColumnClick = null;
        let pointerStart = null;
        let clearGroupTimer = 0;

        const isCoarsePointer = () => Boolean(window.matchMedia?.(coarsePointerQuery)?.matches);

        const setGroupHitState = (isHit) => {
          window.clearTimeout(clearGroupTimer);
          clearGroupTimer = 0;
          item.classList.toggle('is-column-hit', isHit);
        };

        const setColumnHitState = (isHit) => {
          setGroupHitState(isHit);
          stack.style.cursor = isHit ? 'pointer' : '';
        };

        const clearColumnHitState = () => {
          setGroupHitState(false);
          stack.style.cursor = '';
        };

        const scheduleGroupClear = () => {
          window.clearTimeout(clearGroupTimer);
          clearGroupTimer = window.setTimeout(clearColumnHitState, 80);
        };

        const buildHitCanvas = () => {
          if (!image.naturalWidth || !image.naturalHeight || context) return;

          naturalWidth = image.naturalWidth;
          naturalHeight = image.naturalHeight;

          const canvas = document.createElement('canvas');
          canvas.width = naturalWidth;
          canvas.height = naturalHeight;

          const nextContext = canvas.getContext('2d', { willReadFrequently: true });
          if (!nextContext) return;

          nextContext.drawImage(image, 0, 0, naturalWidth, naturalHeight);
          context = nextContext;
          flushPendingColumnClick();
        };

        const isPointInsideImageRect = (point) => {
          const rect = image.getBoundingClientRect();

          return (
            rect.width > 0 &&
            rect.height > 0 &&
            point.clientX >= rect.left &&
            point.clientX <= rect.right &&
            point.clientY >= rect.top &&
            point.clientY <= rect.bottom
          );
        };

        const isColumnPixel = (event) => {
          if (!isCoarsePointer()) {
            buildHitCanvas();
          }

          if (!context || !naturalWidth || !naturalHeight) return false;

          const rect = image.getBoundingClientRect();

          if (
            rect.width <= 0 ||
            rect.height <= 0 ||
            event.clientX < rect.left ||
            event.clientX > rect.right ||
            event.clientY < rect.top ||
            event.clientY > rect.bottom
          ) {
            return false;
          }

          const x = Math.min(
            naturalWidth - 1,
            Math.max(0, Math.floor(((event.clientX - rect.left) / rect.width) * naturalWidth)),
          );
          const y = Math.min(
            naturalHeight - 1,
            Math.max(0, Math.floor(((event.clientY - rect.top) / rect.height) * naturalHeight)),
          );
          const [red, green, blue, alpha] = context.getImageData(x, y, 1, 1).data;

          return (
            alpha > alphaThreshold &&
            !(red > backgroundThreshold && green > backgroundThreshold && blue > backgroundThreshold)
          );
        };

        const getPointerDistance = (event) => {
          if (!pointerStart) return 0;

          return Math.hypot(event.clientX - pointerStart.x, event.clientY - pointerStart.y);
        };

        const flushPendingColumnClick = () => {
          if (!pendingColumnClick || !context) return;

          const pendingEvent = pendingColumnClick;
          pendingColumnClick = null;

          if (isColumnPixel(pendingEvent)) {
            link.click();
          }
        };

        const prepareFinePointerHitCanvas = () => {
          if (isCoarsePointer()) return;

          if (image.complete) {
            buildHitCanvas();
          } else {
            image.addEventListener('load', buildHitCanvas, { once: true });
          }

          image.decode?.().then(buildHitCanvas).catch(() => {
            // The load event fallback above covers browsers that reject decode during navigation.
          });
        };

        const isImmediateColumnTap = (event) =>
          !context && isCoarsePointer() && isPointInsideImageRect(event);

        prepareFinePointerHitCanvas();

        stack.addEventListener('pointermove', (event) => {
          setColumnHitState(isColumnPixel(event));
        });

        stack.addEventListener('pointerdown', (event) => {
          const isHit = isImmediateColumnTap(event) || isColumnPixel(event);

          pointerStart = isHit
            ? {
                id: event.pointerId,
                x: event.clientX,
                y: event.clientY,
              }
            : null;
          setColumnHitState(isHit);
        });

        stack.addEventListener('pointerup', (event) => {
          if (!pointerStart || pointerStart.id !== event.pointerId) return;

          setColumnHitState(isImmediateColumnTap(event) || isColumnPixel(event));
        });

        stack.addEventListener('pointercancel', () => {
          pointerStart = null;
          clearColumnHitState();
        });

        stack.addEventListener('pointerleave', () => {
          pointerStart = null;
          scheduleGroupClear();
        });

        stack.addEventListener('click', (event) => {
          const movedPastClick = getPointerDistance(event) > clickMoveTolerance;

          if (!movedPastClick && (isImmediateColumnTap(event) || isColumnPixel(event))) {
            event.preventDefault();
            event.stopPropagation();
            link.click();
          } else if (!movedPastClick && !context && isPointInsideImageRect(event)) {
            pendingColumnClick = {
              clientX: event.clientX,
              clientY: event.clientY,
            };
          }

          pointerStart = null;
        });

        const setLinkHitState = () => {
          setGroupHitState(true);
          stack.style.cursor = '';
        };

        link.addEventListener('pointerenter', setLinkHitState);
        link.addEventListener('pointermove', setLinkHitState);
        link.addEventListener('pointerdown', setLinkHitState);
        link.addEventListener('mouseenter', setLinkHitState);
        link.addEventListener('mousemove', setLinkHitState);

        link.addEventListener('pointerleave', scheduleGroupClear);
        link.addEventListener('focus', () => setGroupHitState(true));
        link.addEventListener('blur', scheduleGroupClear);
      });
    };

    setupColumnFootprintHitboxes();

    if (window.__varelismHomeColumnFootprintHitboxesReady) return;

    window.__varelismHomeColumnFootprintHitboxesReady = true;
    document.addEventListener('astro:page-load', setupColumnFootprintHitboxes);
  })();
</script>

<script is:inline>
  (() => {
    const canvasSelector = '[data-varelism-home-field]';
    const cleanupKey = '__varelismHomeQuadraticFieldCleanup';
    const listenerKey = '__varelismHomeQuadraticFieldListenersReady';

    const createRandom = (seed) => {
      let state = seed >>> 0;

      return () => {
        state += 0x6d2b79f5;
        let value = state;
        value = Math.imul(value ^ (value >>> 15), value | 1);
        value ^= value + Math.imul(value ^ (value >>> 7), value | 61);
        return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
      };
    };

    const setupQuadraticField = () => {
      const canvas = document.querySelector(canvasSelector);

      if (!(canvas instanceof HTMLCanvasElement)) {
        window[cleanupKey]?.();
        window[cleanupKey] = null;
        return;
      }

      if (canvas.dataset.quadraticFieldReady === 'true') return;

      window[cleanupKey]?.();
      canvas.dataset.quadraticFieldReady = 'true';

      const section = canvas.closest('.triptych');
      const context = canvas.getContext('2d', {
        alpha: true,
        desynchronized: true,
      });

      if (!(section instanceof HTMLElement) || !context) return;

      const coefficientPresets = [
        {
          MX: [-0.7899, -0.2098, 0.1871, -0.7203, -0.04, -0.1696],
          MY: [0.0207, 0.1271, 0.3435, -0.4927, -0.4201, -1.3579],
          origin: [-0.584, 0.053],
          burnIn: 1,
          seedRadius: 0.62,
          scale: 2,
        },
        {
          MX: [-0.8789, -0.1181, -0.022, -0.7561, 0.0935, -0.2488],
          MY: [0.2548, -0.0124, 0.5145, -0.6869, -0.2378, -1.5551],
          origin: [-0.746, 0.226],
          burnIn: 24,
          seedRadius: 0.5,
          scale: 0.62,
        },
        {
          MX: [-0.9353, -0.2361, 0.186, -0.8929, 0.0875, 0.0543],
          MY: [0.2357, -0.065, 0.4288, -0.3622, -0.6349, -1.3892],
          origin: [-0.559, 0.162],
          burnIn: 26,
          seedRadius: 0.5,
          scale: 0.68,
        },
        {
          MX: [-0.767, -0.2459, 0.1722, -0.5152, 0.1907, -0.4096],
          MY: [-0.0318, -0.0149, 0.5845, -0.3832, -0.6054, -1.432],
          origin: [-0.781, -0.026],
          burnIn: 24,
          seedRadius: 0.48,
          scale: 0.58,
        },
        {
          MX: [-0.7539, -0.0891, 0.2545, -0.7965, 0.1029, 0.0042],
          MY: [0.2489, -0.1075, 0.5371, -0.5869, -0.597, -1.4464],
          origin: [-0.508, 0.261],
          burnIn: 22,
          seedRadius: 0.48,
          scale: 1.05,
        },
      ];
      const mutationRadius = 0.025;
      const randomSeed = Math.floor(Math.random() * 4294967296) >>> 0;
      const random = createRandom(randomSeed || 1);
      const selectedPreset =
        coefficientPresets[Math.floor(random() * coefficientPresets.length)] ?? coefficientPresets[0];
      const coefficients = {
        MX: selectedPreset.MX.map((value) => value + (random() * 2 - 1) * mutationRadius),
        MY: selectedPreset.MY.map((value) => value + (random() * 2 - 1) * mutationRadius),
      };
      const safeBound = 5.25;
      const drawBound = 2.1;
      const colorPhase = random() * Math.PI * 2;
      const driftPhase = random() * Math.PI * 2;
      let width = 0;
      let height = 0;
      let dpr = 1;
      let isCompact = false;
      let iterationsPerFrame = 120;
      let dotSize = 0.9;
      let fieldScale = 1;
      let particleCursor = 0;
      let anchorCursor = Math.floor(random() * 1000);
      let resizeFrameId = 0;
      let frameId = 0;
      let isRunning = false;
      const particles = [];

      const chooseColor = (time) => {
        const blueWeight = 0.22 + ((Math.sin(time * 0.00004 + colorPhase) + 1) / 2) * 0.05;
        const roll = random();

        if (roll < 0.014) return 'rgba(105, 27, 23, 0.068)';
        if (roll < blueWeight) return 'rgba(27, 55, 67, 0.086)';
        if (roll < 0.7) return 'rgba(112, 116, 116, 0.096)';
        return 'rgba(204, 204, 198, 0.105)';
      };

      const resetParticle = (particle = {}) => {
        const seedRadius = selectedPreset.seedRadius * (isCompact ? 0.84 : 1);
        const anchorIndex = (anchorCursor += 1);
        const anchorX = (anchorIndex * 0.6180339887498949 + random() * 0.08) % 1;
        const anchorY = (anchorIndex * 0.4142135623730951 + random() * 0.08) % 1;

        particle.x = (random() * 2 - 1) * seedRadius;
        particle.y = (random() * 2 - 1) * seedRadius * 0.82;
        particle.anchorX = width * (0.055 + anchorX * 0.89);
        particle.anchorY = height * ((isCompact ? 0.17 : 0.13) + anchorY * (isCompact ? 0.7 : 0.78));
        particle.drift = random() * Math.PI * 2;
        particle.age = 0;
        particle.burn = selectedPreset.burnIn + Math.floor(random() * (isCompact ? 3 : 5));
        particle.life = particle.burn + 36 + Math.floor(random() * (isCompact ? 44 : 76));

        return particle;
      };

      const syncParticles = () => {
        const nextCount = isCompact ? 16 : 54;

        while (particles.length < nextCount) {
          particles.push(resetParticle({}));
        }

        particles.length = nextCount;
        particleCursor %= particles.length;
      };

      const resizeCanvas = () => {
        const rect = section.getBoundingClientRect();
        const nextWidth = Math.max(1, Math.round(rect.width));
        const nextHeight = Math.max(1, Math.round(rect.height));
        const nextDpr = Math.min(2, Math.max(1, window.devicePixelRatio || 1));
        const nextCompact = nextWidth < 720;
        const sizeChanged = nextWidth !== width || nextHeight !== height || nextDpr !== dpr;

        width = nextWidth;
        height = nextHeight;
        dpr = nextDpr;
        isCompact = nextCompact;
        iterationsPerFrame = isCompact ? 96 : 320;
        dotSize = isCompact ? 0.82 : 0.96;
        fieldScale =
          Math.min(width, height) *
          (isCompact ? 0.1 : 0.12) *
          (0.75 + selectedPreset.scale * 0.35);

        if (sizeChanged) {
          canvas.width = Math.ceil(width * dpr);
          canvas.height = Math.ceil(height * dpr);
          context.setTransform(dpr, 0, 0, dpr, 0, 0);
          context.clearRect(0, 0, width, height);
        }

        syncParticles();

        if (sizeChanged) {
          particles.forEach(resetParticle);
        }
      };

      const queueResize = () => {
        if (resizeFrameId) return;

        resizeFrameId = window.requestAnimationFrame(() => {
          resizeFrameId = 0;
          resizeCanvas();
        });
      };

      const advanceParticle = (particle) => {
        const x = particle.x;
        const y = particle.y;
        const MX = coefficients.MX;
        const MY = coefficients.MY;
        const xNext =
          MX[0] + MX[1] * x + MX[2] * x * x + MX[3] * x * y + MX[4] * y + MX[5] * y * y;
        const yNext =
          MY[0] + MY[1] * x + MY[2] * x * x + MY[3] * x * y + MY[4] * y + MY[5] * y * y;

        if (
          !Number.isFinite(xNext) ||
          !Number.isFinite(yNext) ||
          Math.abs(xNext) > safeBound ||
          Math.abs(yNext) > safeBound ||
          particle.age > particle.life
        ) {
          resetParticle(particle);
          return null;
        }

        particle.x = xNext;
        particle.y = yNext;
        particle.age += 1;

        if (
          particle.age <= particle.burn ||
          Math.abs(xNext) > drawBound ||
          Math.abs(yNext) > drawBound
        ) {
          return null;
        }

        return particle;
      };

      const drawParticle = (particle, time) => {
        const driftX =
          Math.sin(time * 0.000024 + driftPhase + particle.drift) *
          width *
          (isCompact ? 0.01 : 0.016);
        const driftY =
          Math.cos(time * 0.00002 + driftPhase * 0.7 + particle.drift) *
          height *
          (isCompact ? 0.008 : 0.012);
        const centerX = particle.anchorX + driftX;
        const centerY = particle.anchorY + driftY;
        const x = particle.x - selectedPreset.origin[0];
        const y = particle.y - selectedPreset.origin[1];
        const px = centerX + x * fieldScale;
        const py = centerY + y * fieldScale * 0.78;

        if (px < -2 || py < -2 || px > width + 2 || py > height + 2) return;

        context.fillStyle = chooseColor(time);
        context.fillRect(
          Math.round(px * dpr) / dpr,
          Math.round(py * dpr) / dpr,
          dotSize,
          dotSize,
        );
      };

      const render = (time = 0) => {
        frameId = 0;

        if (!isRunning || document.hidden || !section.isConnected) return;

        context.save();
        context.globalCompositeOperation = 'destination-out';
        context.fillStyle = 'rgba(0, 0, 0, 0.018)';
        context.fillRect(0, 0, width, height);
        context.restore();

        context.globalCompositeOperation = 'source-over';

        for (let index = 0; index < iterationsPerFrame; index += 1) {
          const particle = particles[particleCursor];
          particleCursor = (particleCursor + 1) % particles.length;
          const point = advanceParticle(particle);

          if (point) drawParticle(point, time);
        }

        frameId = window.requestAnimationFrame(render);
      };

      const start = () => {
        if (isRunning || document.hidden) return;

        isRunning = true;
        resizeCanvas();
        frameId = window.requestAnimationFrame(render);
      };

      const stop = () => {
        isRunning = false;

        if (frameId) {
          window.cancelAnimationFrame(frameId);
          frameId = 0;
        }
      };

      const handleVisibility = () => {
        if (document.hidden) {
          stop();
        } else {
          start();
        }
      };

      const resizeObserver = window.ResizeObserver ? new ResizeObserver(queueResize) : null;

      resizeObserver?.observe(section);
      window.addEventListener('resize', queueResize, { passive: true });
      document.addEventListener('visibilitychange', handleVisibility);

      window[cleanupKey] = () => {
        stop();
        resizeObserver?.disconnect();
        window.removeEventListener('resize', queueResize);
        document.removeEventListener('visibilitychange', handleVisibility);

        if (resizeFrameId) {
          window.cancelAnimationFrame(resizeFrameId);
          resizeFrameId = 0;
        }

        delete canvas.dataset.quadraticFieldReady;
      };

      start();
    };

    setupQuadraticField();

    if (window[listenerKey]) return;

    window[listenerKey] = true;
    document.addEventListener('astro:before-swap', () => {
      window[cleanupKey]?.();
      window[cleanupKey] = null;
    });
    document.addEventListener('astro:page-load', setupQuadraticField);
  })();
</script>

<style>
  :global(.site-shell > main) {
    display: grid;
    max-width: none;
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    padding: 0;
    place-items: center;
  }

  .triptych {
    align-items: center;
    display: grid;
    gap: clamp(1.5rem, 6vw, 7rem);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    justify-items: center;
    margin: 0 auto;
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    padding: clamp(1.5rem, 4vh, 3rem) clamp(1.25rem, 6vw, 6rem);
    position: relative;
    width: min(100%, 1280px);
  }

  .triptych-field {
    display: block;
    height: 100%;
    inset: 0;
    opacity: 0.88;
    pointer-events: none;
    position: absolute;
    width: 100%;
    z-index: 0;
  }

  .triptych-item {
    align-items: center;
    color: #000000;
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.8vh, 1.25rem);
    min-width: 0;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    position: relative;
    user-select: none;
    width: 100%;
    z-index: 1;
  }

  .triptych-link {
    color: inherit;
    display: block;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  h1 {
    color: currentColor;
    font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    font-size: clamp(1.35rem, 2.1vw, 2.15rem);
    font-weight: 300;
    letter-spacing: 0;
    line-height: 1;
    margin: 0;
    text-align: center;
    transition: color 180ms ease;
  }

  .column-stack {
    display: grid;
    max-width: 100%;
    position: relative;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    width: clamp(6.25rem, 17vw, 13.25rem);
  }

  .column {
    display: block;
    grid-area: 1 / 1;
    height: auto;
    max-width: 100%;
    pointer-events: none;
    width: 100%;
  }

  .column-hover {
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .triptych-item.is-column-hit h1 {
    color: #691b17;
  }

  .triptych-item.is-column-hit .column-hover {
    opacity: 1;
  }

  .triptych-item:focus-within h1 {
    color: #691b17;
  }

  .triptych-item:focus-within .column-hover {
    opacity: 1;
  }

  .triptych-link:focus-visible h1 {
    color: #691b17;
  }

  .triptych-link:focus-visible {
    outline: 1px solid #691b17;
    outline-offset: 0.75rem;
  }

  .triptych-link:hover h1 {
    color: #691b17;
  }

  .triptych-link:hover + .column-stack .column-hover {
    opacity: 1;
  }

  .triptych-link:active h1 {
    color: #691b17;
  }

  .triptych-link:active + .column-stack .column-hover {
    opacity: 1;
  }

  @media (max-width: 720px) {
    .triptych {
      gap: clamp(1rem, 4vw, 2rem);
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .triptych-item {
      gap: 0.8rem;
    }

    h1 {
      font-size: clamp(0.95rem, 3.8vw, 1.25rem);
    }

    .column-stack {
      width: clamp(4.25rem, 26vw, 7rem);
    }
  }

  @media (max-width: 430px) {
    .triptych {
      gap: 0.75rem;
    }
  }
</style>
