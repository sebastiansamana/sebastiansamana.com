---
import type { GetStaticPaths } from 'astro';
import PdfScrollViewer from '../../../components/PdfScrollViewer.jsx';
import { portfolios } from '../../../data/portfolios';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = (() =>
  portfolios.map((portfolio) => ({
    params: { slug: portfolio.id },
    props: { portfolio },
  }))) satisfies GetStaticPaths;

const { portfolio } = Astro.props;
const description = [portfolio.subtitle, portfolio.pageCount ? `${portfolio.pageCount} pages` : undefined]
  .filter(Boolean)
  .join(' / ');
---

<BaseLayout title={`${portfolio.title} | Varelism`} description={description || portfolio.title}>
  <article class="portfolio-detail" data-varelism-route-reveal>
    <a class="portfolio-back" href="/architect/portfolios/">Return</a>
    <PdfScrollViewer client:only="react" pdfUrl={portfolio.pdfUrl} title={portfolio.title} />
  </article>
</BaseLayout>

<style>
  :global(.site-shell > main) {
    --portfolio-detail-top-offset: clamp(7rem, 13vh, 8.5rem);
    max-width: none;
    padding: var(--portfolio-detail-top-offset) clamp(0.75rem, 2.4vw, 2rem) 0;
    width: 100%;
  }

  .portfolio-detail {
    color: #000000;
    margin: 0 auto;
    min-height: calc(100vh - var(--portfolio-detail-top-offset));
    padding-bottom: clamp(2rem, 6vh, 4rem);
    width: 100%;
  }

  .portfolio-back {
    color: #691b17;
    display: inline-block;
    font-size: clamp(0.82rem, 1vw, 0.98rem);
    font-weight: 200;
    line-height: 1;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    transition: color 180ms ease;
  }

  .portfolio-back:focus-visible,
  .portfolio-back:hover {
    color: #000000;
  }

  .portfolio-back:focus-visible {
    outline: 1px solid #691b17;
    outline-offset: 0.35rem;
  }

  @supports (height: 100svh) {
    .portfolio-detail {
      min-height: calc(100svh - var(--portfolio-detail-top-offset));
    }
  }

  @media (max-width: 760px) {
    :global(.site-shell > main) {
      --portfolio-detail-top-offset: 6.5rem;
      padding-left: clamp(0.5rem, 2.4vw, 1rem);
      padding-right: clamp(0.5rem, 2.4vw, 1rem);
      padding-top: var(--portfolio-detail-top-offset);
    }

    .portfolio-back {
      font-size: 0.72rem;
      margin-bottom: clamp(1.5rem, 5vw, 2.5rem);
    }
  }
</style>
