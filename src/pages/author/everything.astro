---
import { getCollection } from 'astro:content';
import AuthorIndexArchive from '../../components/AuthorIndexArchive.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAuthorItemMetadata, getAuthorItemTitle, getPublicAuthorItems } from '../../lib/authorItems';

const items = getPublicAuthorItems(await getCollection('authorItems'));
const rows = items.map((item) => ({
  href: `/author/everything/${item.slug}/`,
  metadata: getAuthorItemMetadata(item),
  title: getAuthorItemTitle(item),
}));
---

<BaseLayout title="Everything | Varelism" description="Everything.">
  <AuthorIndexArchive emptyLabel="No public texts yet." label="Everything" rows={rows} />
</BaseLayout>
