---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getArtworkDetailMetadata, getPublicArtworks } from '../../../lib/artworks';

export const getStaticPaths = (async () => {
  const artworks = getPublicArtworks(await getCollection('artworks'));

  return artworks.map((artwork) => ({
    params: { slug: artwork.id },
    props: { artwork },
  }));
}) satisfies GetStaticPaths;

const { artwork } = Astro.props;
const metadata = getArtworkDetailMetadata(artwork);
const enquiryEmail = 'sebastian.samana@icloud.com';
const enquiryDetails = metadata.map((item) => item.value).join(' / ');
const enquiryBody = [
  'Hello Sebastian,',
  '',
  'I would like to enquire further about this artwork:',
  '',
  artwork.data.title,
  ...(enquiryDetails ? [enquiryDetails] : []),
  '',
  'My query:',
].join('\n');
const enquiryHref = `mailto:${enquiryEmail}?subject=${encodeURIComponent(
  `Enquiry about ${artwork.data.title}`
)}&body=${encodeURIComponent(enquiryBody)}`;
const hasDescription = Boolean(artwork.data.description);
---

<BaseLayout title={`${artwork.data.title} | Samana`} description={artwork.data.description ?? artwork.data.title}>
  <article class="artwork-detail" data-varelism-route-reveal data-varelism-route-reveal-images="true">
    <a class="artwork-back" href="/painter/everything/">Return</a>

    <figure class="artwork-figure">
      {
        artwork.data.image && artwork.data.imageWidth && artwork.data.imageHeight && (
          <img
            src={artwork.data.image}
            alt={artwork.data.imageAlt ?? artwork.data.title}
            width={artwork.data.imageWidth}
            height={artwork.data.imageHeight}
            decoding="async"
          />
        )
      }
      <figcaption>
        <h1>{artwork.data.title}</h1>
        {
          metadata.length > 0 && (
            <dl>
              {
                metadata.map((item) => (
                  <div>
                    <dt>{item.label}</dt>
                    <dd>{item.value}</dd>
                  </div>
                ))
              }
            </dl>
          )
        }
        <a class="artwork-enquiry" href={enquiryHref}>Enquire further</a>
      </figcaption>
    </figure>

    {hasDescription && <p class="artwork-description">{artwork.data.description}</p>}
  </article>
</BaseLayout>

<style>
  :global(.site-shell > main) {
    --artwork-detail-top-offset: clamp(7rem, 13vh, 8.5rem);
    max-width: none;
    padding: var(--artwork-detail-top-offset) clamp(1rem, 4vw, 3rem) 0;
    width: 100%;
  }

  .artwork-detail {
    --artwork-back-font-size: clamp(0.82rem, 1vw, 0.98rem);
    --artwork-back-gap: clamp(2rem, 5vw, 4rem);
    --artwork-detail-viewport-height: 100vh;
    --artwork-detail-image-max-height: calc(
      var(--artwork-detail-viewport-height) - var(--artwork-detail-top-offset) -
        var(--artwork-back-font-size) - var(--artwork-back-gap) - 1rem
    );

    color: #000000;
    margin: 0 auto;
    max-width: 76rem;
    min-height: calc(100vh - var(--artwork-detail-top-offset));
    padding-bottom: clamp(2rem, 6vh, 4rem);
  }

  .artwork-back {
    color: #691b17;
    display: inline-block;
    font-size: var(--artwork-back-font-size);
    font-weight: 200;
    line-height: 1;
    margin-bottom: var(--artwork-back-gap);
    transition: color 180ms ease;
  }

  .artwork-back:focus-visible,
  .artwork-back:hover {
    color: #000000;
  }

  .artwork-back:focus-visible {
    outline: 1px solid #691b17;
    outline-offset: 0.35rem;
  }

  .artwork-figure {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: minmax(0, 1fr) minmax(13rem, 18rem);
    margin: 0;
  }

  .artwork-figure figcaption {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .artwork-figure img {
    align-self: start;
    display: block;
    height: auto;
    justify-self: start;
    max-height: var(--artwork-detail-image-max-height);
    max-width: 100%;
    object-fit: contain;
    width: auto;
  }

  .artwork-figure h1 {
    font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    font-size: clamp(1.35rem, 2.1vw, 2.15rem);
    font-weight: 200;
    letter-spacing: 0;
    line-height: 1;
    margin: 0;
  }

  .artwork-figure dl {
    display: grid;
    gap: 0.65rem;
    margin: 1.6rem 0 0;
  }

  .artwork-figure div {
    display: grid;
    gap: 0.2rem;
  }

  .artwork-figure dt,
  .artwork-figure dd,
  .artwork-enquiry,
  .artwork-description {
    font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    letter-spacing: 0;
  }

  .artwork-figure dt {
    color: #919191;
    font-size: 0.68rem;
    font-weight: 200;
    line-height: 1;
  }

  .artwork-figure dd {
    font-size: 0.88rem;
    font-weight: 300;
    line-height: 1.25;
    margin: 0;
  }

  .artwork-enquiry {
    color: #691b17;
    display: inline-block;
    font-size: var(--artwork-back-font-size);
    font-weight: 200;
    line-height: 1;
    margin-top: auto;
    transition: color 180ms ease;
    width: fit-content;
  }

  .artwork-enquiry:focus-visible,
  .artwork-enquiry:hover {
    color: #000000;
  }

  .artwork-enquiry:focus-visible {
    outline: 1px solid #691b17;
    outline-offset: 0.35rem;
  }

  .artwork-description {
    font-size: 1rem;
    font-weight: 200;
    line-height: 1.55;
    margin: clamp(1.8rem, 5vw, 3.5rem) 0 0;
    max-width: 42rem;
  }

  @supports (height: 100svh) {
    .artwork-detail {
      --artwork-detail-viewport-height: 100svh;
    }
  }

  @media (max-width: 760px) {
    :global(.site-shell > main) {
      --artwork-detail-top-offset: 6.5rem;
      padding-top: var(--artwork-detail-top-offset);
    }

    .artwork-figure {
      grid-template-columns: 1fr;
    }

    .artwork-figure figcaption {
      align-self: start;
    }

    .artwork-figure h1 {
      font-size: clamp(0.95rem, 3.8vw, 1.25rem);
    }

    .artwork-enquiry {
      margin-top: clamp(1.5rem, 5vw, 2.5rem);
    }
  }

  @media (max-width: 560px) {
    .artwork-detail {
      --artwork-back-font-size: 0.72rem;
    }

    .artwork-back {
      font-size: var(--artwork-back-font-size);
    }

    .artwork-figure dt {
      font-size: 0.6rem;
    }

    .artwork-figure dd {
      font-size: var(--artwork-back-font-size);
    }
  }
</style>
