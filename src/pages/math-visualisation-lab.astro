---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Math Visualisation Lab | Varelism"
  description="Temporary isolated polynomial map visualisation lab."
  indexable={false}
>
  <section class="math-lab" aria-label="Math visualisation lab" data-varelism-route-reveal>
    <canvas
      class="math-lab__canvas"
      width="992"
      height="1772"
      data-math-lab-canvas
      data-math-desktop-point-scale="0.72"
      data-math-initial-offset-ms="146000"
      aria-hidden="true"
    ></canvas>
  </section>
</BaseLayout>

<script src="/scripts/math-visualisation-lab-canvas.js?v=20260710-offset146-point72-polynomial-filaments-varelism-red-smooth-camera-point68" defer data-astro-rerun></script>

<style>
  :global(.site-shell) {
    background: #ffffff;
    min-height: 100vh;
  }

  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
    width: 100%;
  }

  :global(.site-header),
  :global(.site-footer),
  :global(astro-dev-toolbar) {
    display: none;
  }

  :global(.site-shell > main) {
    display: grid;
    max-width: none;
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    padding: 0;
    place-items: center;
    width: 100%;
  }

  .math-lab {
    align-items: center;
    background: #ffffff;
    display: block;
    height: 100vh;
    height: 100svh;
    height: 100dvh;
    justify-items: center;
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .math-lab__canvas {
    display: block;
    height: auto;
    left: 50%;
    max-height: none;
    max-width: none;
    object-fit: contain;
    position: absolute;
    top: 50%;
    transform-origin: center center;
    transform: translate(-50%, -50%);
    width: max(102vw, calc(102dvh * 992 / 1772));
  }

  @media (max-width: 560px) {
    .math-lab__canvas {
      height: auto;
      max-height: none;
      max-width: none;
      transform: translate(-50%, -50%);
      width: max(116vw, calc(104dvh * 992 / 1772));
    }
  }

  @media (max-width: 640px) and (orientation: portrait) {
    .math-lab__canvas {
      transform: translate(-50%, -50%) rotate(90deg);
      width: max(104dvh, calc(118vw * 992 / 1772));
    }
  }
</style>
