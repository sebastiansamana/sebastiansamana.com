---
import AboutComposition from '../components/AboutComposition.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const paragraphs = [
  'Sebastian Varela was 20 years old when he vibe-coded this website in 2026.',
  'Varela studies at the Manchester School of Architecture. His vision is to be accepted by the MIT SA+P in the near future. This website is the result of a rare combination of rigor and idealism. It is populated by his writing, architecture, and painting. With a purpose to better understand humanity, the world, and the self through these mediums.',
  'Varela thought of a way to name his purpose. He looked at the innocence of childhood.',
  'Many years ago, his father plays the guitar at night. He feels happy hearing the music. His mother waits by the door. After the prayer, his father retreats to his mother, silhouettes glowing from the warm light behind.',
  'Until Tomorrow is the direct translation. In Spanish, this means Hasta Mañana and in Catalan Fins Demà. So, let him mix them…',
  'Samana.',
  'Varela names his purpose Samana.',
  'In dreams he has a clear image of Samana. But releasing them into reality, in this the task and mighty labor lies.',
];
---

<BaseLayout title="About | Varelism" description="About.">
  <AboutComposition
    imageAlt="Sebastian Varela portrait"
    label="About"
    paragraphs={paragraphs}
  />
</BaseLayout>
