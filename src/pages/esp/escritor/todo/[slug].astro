---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import AuthorItemDetail from '../../../../components/AuthorItemDetail.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getAuthorItemTitle, getPublicAuthorItems } from '../../../../lib/authorItems';

export const getStaticPaths = (async () => {
  const items = getPublicAuthorItems(await getCollection('authorItems'));

  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}) satisfies GetStaticPaths;

const { item } = Astro.props;
const title = getAuthorItemTitle(item, 'es');
---

<BaseLayout title={`${title} | Samana`} description={title}>
  <AuthorItemDetail backHref="/esp/escritor/todo/" backLabel="Volver" item={item} locale="es" />
</BaseLayout>
