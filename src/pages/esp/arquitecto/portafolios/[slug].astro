---
import type { GetStaticPaths } from 'astro';
import PdfScrollViewer from '../../../../components/PdfScrollViewer.astro';
import { portfolios } from '../../../../data/portfolios';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

export const getStaticPaths = (() =>
  portfolios.map((portfolio) => ({
    params: { slug: portfolio.id },
    props: { portfolio },
  }))) satisfies GetStaticPaths;

const { portfolio } = Astro.props;
const description = [portfolio.subtitle, portfolio.pageCount ? `${portfolio.pageCount} páginas` : undefined]
  .filter(Boolean)
  .join(' / ');
const enquiryEmail = 'bastivarela@icloud.com';
const enquiryDetails = [portfolio.subtitle, portfolio.pageCount ? `${portfolio.pageCount} páginas dobles` : undefined]
  .filter(Boolean)
  .join(' / ');
const enquiryBody = [
  'Hola Sebastian,',
  '',
  'Me gustaría consultar más sobre este portafolio:',
  '',
  portfolio.title,
  ...(enquiryDetails ? [enquiryDetails] : []),
  '',
  'Mi consulta:',
].join('\n');
const enquiryHref = `mailto:${enquiryEmail}?subject=${encodeURIComponent(
  `Consulta sobre ${portfolio.title}`,
)}&body=${encodeURIComponent(enquiryBody)}`;
---

<BaseLayout title={`${portfolio.title} | Varelism`} description={description || portfolio.title}>
  <article class="portfolio-detail" id="portfolio-detail-top" data-varelism-route-reveal>
    <header class="portfolio-detail__header">
      <a class="portfolio-detail__link portfolio-detail__return" href="/esp/arquitecto/portafolios/">Volver</a>
      <a
        class="portfolio-detail__link portfolio-detail__document"
        href={`/esp/arquitecto/portafolios/${portfolio.id}/pdf/`}
        target="_blank"
        rel="noopener"
        aria-label={`Abrir ${portfolio.title} en el visor PDF de Varelism`}
      >
        Abrir PDF
      </a>
    </header>

    <PdfScrollViewer
      pdfUrl={portfolio.pdfUrl}
      title={portfolio.title}
      ariaLabel={`${portfolio.title} PDF`}
      pageCount={portfolio.pageCount}
      pageAspectRatios={portfolio.pageAspectRatios}
      previewImage={portfolio.pdfPreviewImage}
      previewImageWidth={portfolio.pdfPreviewImageWidth}
      previewImageHeight={portfolio.pdfPreviewImageHeight}
      pageLabel="Página"
      loadingLabel="Preparando el portafolio en alta resolución"
      fallbackLabel="No se pudo cargar el visor del portafolio."
      openPdfLabel="Abrir el PDF original"
      pageErrorLabel="No se pudo mostrar esta página."
    />

    <footer class="portfolio-detail__footer">
      <a class="portfolio-detail__link portfolio-detail__enquiry" href={enquiryHref}>Consultar más</a>
      <button class="portfolio-detail__link portfolio-detail__top" type="button" data-portfolio-back-to-top>
        Volver arriba
      </button>
    </footer>
  </article>
</BaseLayout>

<script>
  (() => {
    const setupBackToTop = () => {
      document.querySelectorAll('[data-portfolio-back-to-top]').forEach((button) => {
        if (!(button instanceof HTMLButtonElement) || button.dataset.portfolioBackToTopReady === 'true') return;

        button.dataset.portfolioBackToTopReady = 'true';
        button.addEventListener('click', () => {
          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          window.scrollTo({
            behavior: prefersReducedMotion ? 'auto' : 'smooth',
            top: 0,
          });
        });
      });
    };

    setupBackToTop();
    document.addEventListener('astro:page-load', setupBackToTop);
  })();
</script>

<style>
  :global(.site-shell > main) {
    --portfolio-detail-top-offset: clamp(7rem, 13vh, 8.5rem);
    --portfolio-detail-content-width: min(100%, 92rem);
    max-width: none;
    padding: var(--portfolio-detail-top-offset) clamp(0.75rem, 2.4vw, 2rem) 0;
    width: 100%;
  }

  .portfolio-detail {
    --portfolio-back-gap: clamp(2rem, 5vw, 4rem);
    color: #000000;
    margin: 0 auto;
    min-height: calc(100vh - var(--portfolio-detail-top-offset));
    padding-bottom: clamp(2rem, 6vh, 4rem);
    width: 100%;
  }

  .portfolio-detail__header,
  .portfolio-detail__footer,
  :global(.portfolio-detail .pdf-scroll-viewer) {
    margin-left: auto;
    margin-right: auto;
    width: var(--portfolio-detail-content-width);
  }

  .portfolio-detail__header {
    align-items: baseline;
    display: flex;
    gap: clamp(0.9rem, 2vw, 1.45rem);
    justify-content: space-between;
    margin-bottom: var(--portfolio-back-gap);
  }

  .portfolio-detail__link {
    font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    font-size: clamp(0.82rem, 1vw, 0.98rem);
    letter-spacing: 0;
    line-height: 1;
    margin: 0;
  }

  .portfolio-detail__link {
    color: #691b17;
    display: inline-block;
    font-weight: 200;
    transition: color 180ms ease;
  }

  .portfolio-detail__link:focus-visible,
  .portfolio-detail__link:hover {
    color: #000000;
  }

  .portfolio-detail__link:focus-visible {
    outline: 1px solid #691b17;
    outline-offset: 0.35rem;
  }

  .portfolio-detail__footer {
    align-items: baseline;
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    justify-content: space-between;
    margin-top: clamp(1.2rem, 3vw, 2.5rem);
  }

  .portfolio-detail__top {
    appearance: none;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
  }

  @supports (height: 100svh) {
    .portfolio-detail {
      min-height: calc(100svh - var(--portfolio-detail-top-offset));
    }
  }

  @media (max-width: 760px) {
    :global(.site-shell > main) {
      --portfolio-detail-top-offset: 6.5rem;
      padding-left: clamp(0.5rem, 2.4vw, 1rem);
      padding-right: clamp(0.5rem, 2.4vw, 1rem);
      padding-top: var(--portfolio-detail-top-offset);
    }

    .portfolio-detail__header {
      gap: 0.75rem;
      margin-bottom: clamp(2rem, 7vw, 3rem);
    }

    .portfolio-detail__link {
      font-size: 0.72rem;
    }
  }
</style>
