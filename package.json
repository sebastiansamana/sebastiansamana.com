{
  "name": "sebastian-samana-root",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "generate:artwork-thumbnails": "node scripts/generate-artwork-thumbnails.mjs",
    "generate:artwork-details": "node scripts/generate-artwork-detail-images.mjs",
    "check:artwork-thumbnails": "node scripts/generate-artwork-thumbnails.mjs --check",
    "check:artwork-details": "node scripts/generate-artwork-detail-images.mjs --check",
    "prebuild": "npm run check:artwork-thumbnails && npm run check:artwork-details",
    "test:favicon": "node tests/favicon-assets.mjs",
    "test:artwork-details": "npm run build && node tests/artwork-detail-images.mjs",
    "test:content-guard": "npm run build && node tests/content-guard.mjs",
    "new-artwork": "node scripts/new-artwork.mjs",
    "test:home-mobile": "npm run build && node tests/home-cold-mobile-tap.mjs",
    "test:holder-reveal": "npm run build && node tests/holder-route-reveal.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "d3": "^7.9.0",
    "imagesloaded": "^5.0.0",
    "masonry-layout": "^4.2.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/imagesloaded": "^4.1.7",
    "@types/masonry-layout": "^4.2.8",
    "sharp": "^0.35.5"
  }
}
